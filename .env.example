# Sanity (https://www.sanity.io/manage). Project ID and dataset are public.
PUBLIC_SANITY_PROJECT_ID=bw6geomj
PUBLIC_SANITY_DATASET=production
# Viewer token for draft preview (server-rendered routes only). Never prefix with PUBLIC_.
SANITY_API_READ_TOKEN=
# Newsletter sign-up (Footer form). Any URL that accepts a form-encoded POST with an `email`
# field, returns 2xx on success and allows CORS from the site's origins. Public by design.
PUBLIC_NEWSLETTER_ENDPOINT=
# Search engines. Leave unset: robots.txt then blocks all crawlers. Set to 1 only on the
# Cloudflare production build, at launch.
ALLOW_INDEXING=
