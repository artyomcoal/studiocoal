{
  "name": "studiocoal",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "typegen": "node --env-file-if-exists=.env node_modules/sanity/bin/sanity schema extract --path src/sanity/schema.json --enforce-required-fields --force && node --env-file-if-exists=.env node_modules/sanity/bin/sanity typegen generate",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@data-slot/accordion": "^1.1.2",
    "@data-slot/dialog": "^1.1.2",
    "@lucide/astro": "^1.47.0",
    "@sanity/astro": "^3.6.0",
    "@sanity/client": "^8.14.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.21.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.4",
    "bejamas": "^0.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "groq": "^6.21.0",
    "hls.js": "^1.7.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.21.0",
    "styled-components": "^6.6.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
