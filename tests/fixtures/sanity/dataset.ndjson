{"_id": "work-northlight", "_type": "work", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Northlight", "slug": {"_type": "slug", "current": "northlight"}, "client": "Northlight Energy", "year": 2026, "services": ["brand", "web"], "featured": true, "summary": "A calm, confident identity and website for a grid-scale storage company.", "excerpt": "Northlight builds battery storage for regional grids. We gave them a brand and a website that explain a technical product in plain language, and a system their team can grow on their own.", "industry": ["Energy", "Climate"], "deliverables": [{"_type": "reference", "_ref": "deliverable-brand-strategy", "_key": "d1"}, {"_type": "reference", "_ref": "deliverable-visual-identity", "_key": "d2"}, {"_type": "reference", "_ref": "deliverable-visual-design", "_key": "d3"}], "challenge": "Northlight's product is complex and their audience is broad: utilities, investors and the towns that host their sites. Each needed a different way in.", "solution": "We built the identity around a single idea, steady light, and carried it through a modular website with clear paths for each audience.", "outcome": "The new site launched alongside a funding round. Northlight's team now publishes case studies and updates without help.", "results": [{"_type": "result", "_key": "r1", "value": "3×", "label": "More inbound enquiries"}, {"_type": "result", "_key": "r2", "value": "40%", "label": "Shorter sales cycle"}], "websiteUrl": "https://example.com/northlight", "listingMedia": {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-e58b9059c33580d5d8ea3bb73f5e061b84818aaf-800x1000-png"}, "alt": "Northlight brand mark on a sand background"}}, "heroMedia": {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-efc22a2253af87b1289bf75d71d62355563cd681-1280x720-png"}, "alt": "Northlight hero visual"}}, "archiveMedia": [{"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-e58b9059c33580d5d8ea3bb73f5e061b84818aaf-800x1000-png"}, "alt": "Northlight brand mark"}, "_key": "a1"}, {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-1800b855e837322b3b425cdf475e70ba6da416f5-800x1000-png"}, "alt": "Northlight pattern"}, "_key": "a2"}, {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-826ef5059e2340db2cd485d1698b6148cc5b653b-800x1000-png"}, "alt": "Northlight app screen"}, "_key": "a3"}], "content": [{"_type": "mediaFullWidth", "_key": "c1", "media": {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-762daed806fa2d89b8b1d1202781dbf8201963d1-1280x720-png"}, "alt": "Northlight landscape photography"}}}, {"_type": "mediaPair", "_key": "c2", "left": {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-e58b9059c33580d5d8ea3bb73f5e061b84818aaf-800x1000-png"}, "alt": "Northlight poster"}}, "right": {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-1800b855e837322b3b425cdf475e70ba6da416f5-800x1000-png"}, "alt": "Northlight stationery"}}}]}
{"_id": "work-fieldnote", "_type": "work", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Fieldnote", "slug": {"_type": "slug", "current": "fieldnote"}, "client": "Fieldnote", "year": 2025, "services": ["digital-products"], "summary": "A research tool that turns field interviews into shared, searchable notes.", "excerpt": "Fieldnote helps research teams capture interviews on site. We designed the product from first sketches to a design system the engineers ship from.", "industry": ["Research", "SaaS"], "deliverables": [{"_type": "reference", "_ref": "deliverable-ui-and-ux-design", "_key": "d1"}, {"_type": "reference", "_ref": "deliverable-design-systems", "_key": "d2"}], "challenge": "Researchers worked across paper, voice memos and spreadsheets, and insights were lost between them.", "solution": "One capture flow for every format, and a shared library where notes are tagged and linked as they come in.", "outcome": "Fieldnote's pilot teams moved their whole research practice into the product within a quarter.", "listingMedia": {"_type": "media", "kind": "video", "video": {"_type": "bunnyVideo", "playlistUrl": "https://vz-e2e-fixtures.b-cdn.net/e2e-video-1/playlist.m3u8", "playback": "ambient"}}, "heroMedia": {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-762daed806fa2d89b8b1d1202781dbf8201963d1-1280x720-png"}, "alt": "Fieldnote product overview"}}, "archiveMedia": [{"_type": "media", "kind": "video", "video": {"_type": "bunnyVideo", "playlistUrl": "https://vz-e2e-fixtures.b-cdn.net/e2e-video-1/playlist.m3u8", "playback": "ambient"}, "_key": "a1"}, {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-826ef5059e2340db2cd485d1698b6148cc5b653b-800x1000-png"}, "alt": "Fieldnote mobile capture screen"}, "_key": "a2"}, {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-1800b855e837322b3b425cdf475e70ba6da416f5-800x1000-png"}, "alt": "Fieldnote library view"}, "_key": "a3"}], "content": [{"_type": "mediaFullWidth", "_key": "c1", "media": {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-efc22a2253af87b1289bf75d71d62355563cd681-1280x720-png"}, "alt": "Fieldnote desktop app"}}}]}
{"_id": "journal-quiet-interfaces", "_type": "journal", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Notes on making quiet interfaces", "slug": {"_type": "slug", "current": "quiet-interfaces"}, "publishedAt": "2026-10-12T09:00:00Z", "category": "Process", "featured": true, "excerpt": "Why we remove before we add, and how restraint makes powerful products easier to use.", "coverImage": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-762daed806fa2d89b8b1d1202781dbf8201963d1-1280x720-png"}, "alt": "Moss-coloured abstract landscape"}, "body": [{"_type": "block", "_key": "b1", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "b1s", "marks": [], "text": "Most products don't need more features. They need fewer things competing for attention."}]}, {"_type": "block", "_key": "b2", "style": "h2", "markDefs": [], "children": [{"_type": "span", "_key": "b2s", "marks": [], "text": "Start with the job"}]}, {"_type": "block", "_key": "b3", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "b3s", "marks": [], "text": "Before any screen, we write down the one thing a person came to do. Everything else waits."}]}, {"_type": "block", "_key": "b4", "style": "normal", "markDefs": [{"_type": "link", "_key": "l1", "href": "https://example.com"}], "children": [{"_type": "span", "_key": "b4a", "marks": [], "text": "Read more about it "}, {"_type": "span", "_key": "b4b", "marks": ["l1"], "text": "in our process notes"}, {"_type": "span", "_key": "b4c", "marks": [], "text": "."}]}, {"_type": "block", "_key": "b5", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "b5s", "marks": [], "text": "Remove one thing from every screen"}], "listItem": "bullet", "level": 1}, {"_type": "block", "_key": "b6", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "b6s", "marks": [], "text": "Let type do the work of colour"}], "listItem": "bullet", "level": 1}, {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-efc22a2253af87b1289bf75d71d62355563cd681-1280x720-png"}, "alt": "Abstract ink circle", "_key": "b7"}, {"_type": "block", "_key": "b8", "style": "blockquote", "markDefs": [], "children": [{"_type": "span", "_key": "b8s", "marks": [], "text": "Quiet is not the same as empty."}]}]}
{"_id": "journal-small-studios", "_type": "journal", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Why we stay a small studio", "slug": {"_type": "slug", "current": "small-studio"}, "publishedAt": "2026-09-03T09:00:00Z", "category": "Studio", "excerpt": "A small team means the people you meet are the people who do the work.", "coverImage": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-826ef5059e2340db2cd485d1698b6148cc5b653b-800x1000-png"}, "alt": "Slate abstract shape"}, "body": [{"_type": "block", "_key": "b1", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "b1s", "marks": [], "text": "We keep the studio small on purpose. Every project gets the same senior people from the first call to launch."}]}]}
