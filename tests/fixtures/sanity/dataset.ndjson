{"_id": "deliverable-brand-strategy", "_type": "deliverable", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Brand strategy", "projectTypes": ["brand"], "description": "We start by finding the one idea your company stands on: who it's for, what it believes and why it's different. Everything we design afterwards is measured against it, so the identity has reasons, not just looks."}
{"_id": "deliverable-visual-identity", "_type": "deliverable", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Visual identity", "projectTypes": ["brand"], "description": "Logo, typography, color and the details between them, drawn with care and built to work at any size. A good identity feels inevitable once you see it, and getting there takes many versions you never will."}
{"_id": "deliverable-visual-design", "_type": "deliverable", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Visual design", "projectTypes": ["web"], "description": "This is where the brand meets the browser. We design every page at every breakpoint with the same care, down to spacing, type and the moments in between."}
{"_id": "deliverable-ui-and-ux-design", "_type": "deliverable", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "UI & UX design", "projectTypes": ["digital-products"], "description": "Interfaces that make complex functionality feel calm and obvious. We design every state, edge case and empty screen, not just the happy path."}
{"_id": "deliverable-design-systems", "_type": "deliverable", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Design systems", "projectTypes": ["web", "digital-products"], "description": "A shared library of components, tokens and rules that keeps product and brand in step. We document it in Markdown alongside the code, so designers, engineers and AI coding tools all build from the same source."}
{"_id": "deliverable-art-direction", "_type": "deliverable", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Art direction", "projectTypes": ["brand"], "description": "We set the visual world your brand lives in: photography, illustration, 3D and composition. We explore widely early on, often with generative tools, then commit to one direction and hold every image to it."}
{"_id": "deliverable-motion-systems", "_type": "deliverable", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Motion systems", "projectTypes": ["brand"], "description": "How a brand moves is as recognizable as how it looks. We define timing, easing and transitions as rules, so your product, website and films all move with the same character."}
{"_id": "deliverable-brand-systems", "_type": "deliverable", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Brand systems", "projectTypes": ["brand"], "description": "We turn the identity into a working system: components, templates and guidelines your team can use without calling us. It's built to grow with the company, not to sit in a PDF."}
{"_id": "deliverable-content-strategy-and-copywriting", "_type": "deliverable", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Content strategy & copywriting", "projectTypes": ["web"], "description": "We decide what your site needs to say before we decide how it looks. Writing and design happen side by side, so the words shape the layout rather than being poured in at the end."}
{"_id": "deliverable-architecture-and-ux", "_type": "deliverable", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Architecture & UX", "projectTypes": ["web"], "description": "We plan the structure around the questions your visitors actually ask, in the order they ask them. Clear paths, honest labels, and nothing on a page that doesn't earn its place."}
{"_id": "deliverable-motion-and-interactions", "_type": "deliverable", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Motion & interactions", "projectTypes": ["web"], "description": "Small movements that make a site feel considered: hovers, transitions, reveals. We use them with restraint, and always respect people who prefer less motion."}
{"_id": "deliverable-cms-implementation", "_type": "deliverable", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "CMS implementation", "projectTypes": ["web"], "description": "We set up your CMS around how your team actually works, so publishing a case study or an article takes minutes and no developer. Content is structured and AI-ready, so your team can create new pages with AI tools without starting from scratch."}
{"_id": "deliverable-full-stack-development", "_type": "deliverable", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Full-stack development", "projectTypes": ["web"], "description": "We build what we design, so nothing gets lost between the design file and the browser. Fast, accessible sites that search engines and AI assistants can read, on a documented codebase that's ready to scale."}
{"_id": "deliverable-product-strategy", "_type": "deliverable", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Product strategy", "projectTypes": ["digital-products"], "description": "We help you decide what to build next and why, based on your users, your market and what your team can realistically ship. A clear direction before the first screen saves months later."}
{"_id": "deliverable-user-research-and-testing", "_type": "deliverable", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "User research & testing", "projectTypes": ["digital-products"], "description": "We talk to the people who use your product, and watch them use it. What we learn shapes decisions early, while changing course is still cheap."}
{"_id": "deliverable-journeys-and-jobs-to-be-done", "_type": "deliverable", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Journeys & jobs to be done", "projectTypes": ["digital-products"], "description": "We map what people are trying to get done and every step they take to do it. It shows where the product helps, where it gets in the way, and where the opportunities are."}
{"_id": "deliverable-prototyping-in-code", "_type": "deliverable", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Prototyping in code", "projectTypes": ["digital-products"], "description": "We prototype early and realistically, so ideas get tested in people's hands rather than debated in meetings. Modern tools let us try more variations before committing to one."}
{"_id": "work-northlight", "_type": "work", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Northlight", "slug": {"_type": "slug", "current": "northlight"}, "client": "Northlight Energy", "year": 2026, "services": ["brand", "web"], "featured": true, "summary": "A calm, confident identity and website for a grid-scale storage company.", "excerpt": "Northlight builds battery storage for regional grids. We gave them a brand and a website that explain a technical product in plain language, and a system their team can grow on their own.", "industry": ["Energy", "Climate"], "deliverables": [{"_type": "reference", "_ref": "deliverable-brand-strategy", "_key": "d1"}, {"_type": "reference", "_ref": "deliverable-visual-identity", "_key": "d2"}, {"_type": "reference", "_ref": "deliverable-visual-design", "_key": "d3"}], "challenge": "Northlight's product is complex and their audience is broad: utilities, investors and the towns that host their sites. Each needed a different way in.", "solution": "We built the identity around a single idea, steady light, and carried it through a modular website with clear paths for each audience.", "outcome": "The new site launched alongside a funding round. Northlight's team now publishes case studies and updates without help.", "results": [{"_type": "result", "_key": "r1", "value": "3×", "label": "More inbound enquiries"}, {"_type": "result", "_key": "r2", "value": "40%", "label": "Shorter sales cycle"}], "websiteUrl": "https://example.com/northlight", "listingMedia": {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-e58b9059c33580d5d8ea3bb73f5e061b84818aaf-800x1000-png"}, "alt": "Northlight brand mark on a sand background"}}, "heroMedia": {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-efc22a2253af87b1289bf75d71d62355563cd681-1280x720-png"}, "alt": "Northlight hero visual"}}, "archiveMedia": [{"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-e58b9059c33580d5d8ea3bb73f5e061b84818aaf-800x1000-png"}, "alt": "Northlight brand mark"}, "_key": "a1"}, {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-1800b855e837322b3b425cdf475e70ba6da416f5-800x1000-png"}, "alt": "Northlight pattern"}, "_key": "a2"}, {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-826ef5059e2340db2cd485d1698b6148cc5b653b-800x1000-png"}, "alt": "Northlight app screen"}, "_key": "a3"}], "content": [{"_type": "mediaFullWidth", "_key": "c1", "media": {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-762daed806fa2d89b8b1d1202781dbf8201963d1-1280x720-png"}, "alt": "Northlight landscape photography"}}}, {"_type": "mediaPair", "_key": "c2", "left": {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-e58b9059c33580d5d8ea3bb73f5e061b84818aaf-800x1000-png"}, "alt": "Northlight poster"}}, "right": {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-1800b855e837322b3b425cdf475e70ba6da416f5-800x1000-png"}, "alt": "Northlight stationery"}}}]}
{"_id": "work-fieldnote", "_type": "work", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Fieldnote", "slug": {"_type": "slug", "current": "fieldnote"}, "client": "Fieldnote", "year": 2025, "services": ["digital-products"], "summary": "A research tool that turns field interviews into shared, searchable notes.", "excerpt": "Fieldnote helps research teams capture interviews on site. We designed the product from first sketches to a design system the engineers ship from.", "industry": ["Research", "SaaS"], "deliverables": [{"_type": "reference", "_ref": "deliverable-ui-and-ux-design", "_key": "d1"}, {"_type": "reference", "_ref": "deliverable-design-systems", "_key": "d2"}], "challenge": "Researchers worked across paper, voice memos and spreadsheets, and insights were lost between them.", "solution": "One capture flow for every format, and a shared library where notes are tagged and linked as they come in.", "outcome": "Fieldnote's pilot teams moved their whole research practice into the product within a quarter.", "listingMedia": {"_type": "media", "kind": "video", "video": {"_type": "bunnyVideo", "playlistUrl": "https://vz-e2e-fixtures.b-cdn.net/e2e-video-1/playlist.m3u8", "playback": "ambient"}}, "heroMedia": {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-762daed806fa2d89b8b1d1202781dbf8201963d1-1280x720-png"}, "alt": "Fieldnote product overview"}}, "archiveMedia": [{"_type": "media", "kind": "video", "video": {"_type": "bunnyVideo", "playlistUrl": "https://vz-e2e-fixtures.b-cdn.net/e2e-video-1/playlist.m3u8", "playback": "ambient"}, "_key": "a1"}, {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-826ef5059e2340db2cd485d1698b6148cc5b653b-800x1000-png"}, "alt": "Fieldnote mobile capture screen"}, "_key": "a2"}, {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-1800b855e837322b3b425cdf475e70ba6da416f5-800x1000-png"}, "alt": "Fieldnote library view"}, "_key": "a3"}], "content": [{"_type": "mediaFullWidth", "_key": "c1", "media": {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-efc22a2253af87b1289bf75d71d62355563cd681-1280x720-png"}, "alt": "Fieldnote desktop app"}}}]}
{"_id": "work-tidewater", "_type": "work", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Tidewater", "slug": {"_type": "slug", "current": "tidewater"}, "comingSoon": true, "client": "Tidewater", "year": 2024, "services": ["web"], "summary": "A booking site for a coastal ferry line, with timetables that update live.", "excerpt": "Tidewater runs ferries between six islands. We rebuilt their website around one question: when is the next boat? The case study is still being written.", "listingMedia": {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-1800b855e837322b3b425cdf475e70ba6da416f5-800x1000-png"}, "alt": "Tidewater timetable on a phone"}}, "heroMedia": {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-efc22a2253af87b1289bf75d71d62355563cd681-1280x720-png"}, "alt": "Tidewater website"}}, "archiveMedia": [{"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-1800b855e837322b3b425cdf475e70ba6da416f5-800x1000-png"}, "alt": "Tidewater timetable"}, "_key": "a1"}, {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-e58b9059c33580d5d8ea3bb73f5e061b84818aaf-800x1000-png"}, "alt": "Tidewater booking flow"}, "_key": "a2"}, {"_type": "media", "kind": "image", "image": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-826ef5059e2340db2cd485d1698b6148cc5b653b-800x1000-png"}, "alt": "Tidewater route map"}, "_key": "a3"}]}
{"_id": "journal-quiet-interfaces", "_type": "journal", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Notes on making quiet interfaces", "slug": {"_type": "slug", "current": "quiet-interfaces"}, "publishedAt": "2026-10-12T09:00:00Z", "category": "Process", "featured": true, "excerpt": "Why we remove before we add, and how restraint makes powerful products easier to use.", "coverImage": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-762daed806fa2d89b8b1d1202781dbf8201963d1-1280x720-png"}, "alt": "Moss-coloured abstract landscape"}, "body": [{"_type": "block", "_key": "b1", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "b1s", "marks": [], "text": "Most products don't need more features. They need fewer things competing for attention."}]}, {"_type": "block", "_key": "b2", "style": "h2", "markDefs": [], "children": [{"_type": "span", "_key": "b2s", "marks": [], "text": "Start with the job"}]}, {"_type": "block", "_key": "b3", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "b3s", "marks": [], "text": "Before any screen, we write down the one thing a person came to do. Everything else waits."}]}, {"_type": "block", "_key": "b4", "style": "normal", "markDefs": [{"_type": "link", "_key": "l1", "href": "https://example.com"}], "children": [{"_type": "span", "_key": "b4a", "marks": [], "text": "Read more about it "}, {"_type": "span", "_key": "b4b", "marks": ["l1"], "text": "in our process notes"}, {"_type": "span", "_key": "b4c", "marks": [], "text": "."}]}, {"_type": "block", "_key": "b5", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "b5s", "marks": [], "text": "Remove one thing from every screen"}], "listItem": "bullet", "level": 1}, {"_type": "block", "_key": "b6", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "b6s", "marks": [], "text": "Let type do the work of colour"}], "listItem": "bullet", "level": 1}, {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-efc22a2253af87b1289bf75d71d62355563cd681-1280x720-png"}, "alt": "Abstract ink circle", "_key": "b7", "caption": "Every screen starts as one idea on an empty page."}, {"_type": "block", "_key": "b8", "style": "blockquote", "markDefs": [], "children": [{"_type": "span", "_key": "b8s", "marks": [], "text": "Quiet is not the same as empty."}]}, {"_type": "block", "_key": "x1", "style": "h2", "markDefs": [], "children": [{"_type": "span", "_key": "x1s0", "marks": [], "text": "Cut, then cut again"}]}, {"_type": "block", "_key": "x2", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "x2s0", "marks": [], "text": "Our first drafts are always too busy. So we run a simple review: for each element, we ask "}, {"_type": "span", "_key": "x2s1", "marks": ["em"], "text": "what breaks if it goes"}, {"_type": "span", "_key": "x2s2", "marks": [], "text": ". If the answer is nothing, it goes."}]}, {"_type": "block", "_key": "x3", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "x3s0", "marks": [], "text": "This is slower than adding things. It is also the part of the work clients notice least and feel most."}]}, {"_type": "block", "_key": "x4", "style": "h3", "markDefs": [], "children": [{"_type": "span", "_key": "x4s0", "marks": [], "text": "What we check"}]}, {"_type": "block", "_key": "x5", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "x5s0", "marks": [], "text": "Is the main action obvious within a second?"}], "listItem": "number", "level": 1}, {"_type": "block", "_key": "x6", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "x6s0", "marks": [], "text": "Does every label say what happens next?"}], "listItem": "number", "level": 1}, {"_type": "block", "_key": "x7", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "x7s0", "marks": [], "text": "Would the screen still work in plain text?"}], "listItem": "number", "level": 1}, {"_type": "block", "_key": "x8", "style": "h2", "markDefs": [], "children": [{"_type": "span", "_key": "x8s0", "marks": [], "text": "Let the details carry it"}]}, {"_type": "block", "_key": "x9", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "x9s0", "marks": [], "text": "Once the noise is gone, small things do the heavy lifting: spacing, one "}, {"_type": "span", "_key": "x9s1", "marks": ["strong"], "text": "well-chosen"}, {"_type": "span", "_key": "x9s2", "marks": [], "text": " typeface and motion that explains rather than decorates."}]}, {"_type": "block", "_key": "x10", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "x10s0", "marks": [], "text": "That is where a quiet interface earns its keep. It gets out of the way, and the work people came to do moves to the front."}]}]}
{"_id": "journal-small-studios", "_type": "journal", "_createdAt": "2026-11-01T09:00:00Z", "_updatedAt": "2026-11-01T09:00:00Z", "_rev": "fixture", "title": "Why we stay a small studio", "slug": {"_type": "slug", "current": "small-studio"}, "publishedAt": "2026-09-03T09:00:00Z", "category": "Studio", "excerpt": "A small team means the people you meet are the people who do the work.", "coverImage": {"_type": "imageWithAlt", "asset": {"_type": "reference", "_ref": "image-826ef5059e2340db2cd485d1698b6148cc5b653b-800x1000-png"}, "alt": "Slate abstract shape"}, "body": [{"_type": "block", "_key": "b1", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "b1s", "marks": [], "text": "We keep the studio small on purpose. Every project gets the same senior people from the first call to launch."}]}]}
