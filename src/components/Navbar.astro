---
/**
 * Navbar
 * Figma: https://www.figma.com/design/xqG6nM7oVW4iev0PrbuqWt/?node-id=5005-6313
 *
 * Behaviour modelled on standard-projects.com: a fixed, always-visible frosted pill with every
 * link visible at every breakpoint (no hamburger menu). One shared pill sits under the current
 * section's item (its own CSS background until the first interaction) and slides to whichever
 * item is hovered, focused or pressed (touch), then back
 * when the pointer leaves. Moving the pill never changes the text colours; clicking or tapping
 * an item does, immediately (see NavItem). The nav pill and the button are named View Transition groups, so they stay pinned
 * between pages. The names sit on them, not on <header>: a named element is a backdrop root,
 * which would stop the pill's backdrop-blur from seeing the page.
 *
 * Layout per Figma: from md, pill top-left and "Get in touch" top-right. On base the pill is
 * centred (6px sides) and the button is fixed to the bottom centre of the dynamic viewport
 * (h-dvh), 16px from the bottom edge.
 */
import LogoMark from "@/assets/studio-coal-mark.svg";
import NavItem from "@/components/NavItem.astro";
import { cn } from "@/lib/utils";
import { sanityClient } from "sanity:client";
import { SITE_SETTINGS_QUERY } from "@/sanity/queries";
import GetInTouchModal from "@/components/GetInTouchModal.astro";

interface ArticleLink {
  title: string | null;
  slug: string | null;
}

interface Props {
  class?: string;
  /**
   * Journal article: the nav items give way to this bar (newer / older arrows and the article
   * title) while the reader scrolls down, at every breakpoint. Figma "Navbar - Article" (node 53645:5245).
   */
  article?: { title: string; newer?: ArticleLink | null; older?: ArticleLink | null };
}

const { class: className, article } = Astro.props;
// Article arrows (Figma 53645:5250): a 24px box in the interactive-secondary palette (default /
// hover / pressed, transition-colors like the accordion icon boxes) with a sharp chevron.
const arrow =
  "flex size-6 shrink-0 items-center justify-center rounded-xs bg-interactive-secondary outline-none transition-colors focus-visible:ring-2 focus-visible:ring-interactive-focus-ring";
const arrowLink = "hover:bg-interactive-secondary-hover active:bg-interactive-secondary-active";
// Figma's path, stroke 1.5, default (butt) caps and miter join: square ends, a sharp point.
const chevron = { left: "M14 16L10 12L14 8", right: "M10 8L14 12L10 16" };

/** Default nav; Sanity Site settings › Navigation overrides it when filled in. */
const defaultItems = [
  { label: "Work", href: "/work" },
  { label: "Services", href: "/services" },
  { label: "Process", href: "/process" },
  { label: "Journal", href: "/journal" },
  { label: "About", href: "/about" },
];

const settings = await sanityClient.fetch(SITE_SETTINGS_QUERY);
const items = settings?.navigation?.length
  ? settings.navigation.map(({ label, href }) => ({ label, href }))
  : defaultItems;

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => href !== "/" && (path === href || path.startsWith(`${href}/`));
---

<header
  id="site-header"
  data-slot="navbar"
  class={cn(
    // Base: the pill is centred with 6px sides (Figma base frame: 363px pill in 375px),
    // since five links don't fit inside 16px padding. From md: pill left, button right.
    "pointer-events-none fixed inset-x-0 top-0 z-50 flex items-center justify-center px-1.5 py-4 md:justify-between md:p-4",
    className,
  )}
>
  {/* backdrop-blur-[20px]: the design asks for a 20px blur; Tailwind's blur scale has no 20px step (lg 16px, xl 24px). */}
  <nav
    aria-label="Main"
    class="group/nav pointer-events-auto flex max-w-full min-w-0 items-center gap-1 rounded-sm bg-bg-translucent p-1 backdrop-blur-[20px] view-transition-header"
  >
    <a
      href="/"
      aria-current={path === "/" ? "page" : undefined}
      class="shrink-0 rounded-xs outline-none focus-visible:ring-2 focus-visible:ring-interactive-focus-ring focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
    >
      {/* Inline SVG, not <img>: an image isn't always decoded by the new page's first frame,
          so the logo blinked out for a frame on every page transition. */}
      <LogoMark
        width={32}
        height={32}
        role="img"
        aria-label="Studio Coal home"
        class="block size-8 rounded-xs"
      />
    </a>
    <!-- When the links don't fit (narrow phones, wider font rendering on Android/Linux) they
         scroll sideways inside the pill instead of overflowing it. Scrollbar hidden: no utility. -->
    <!-- The nav items and (on journal articles) the article bar share one grid cell; this box
         masks them, so neither shows outside it while they slide (items up and out, the bar up
         from below). data-mode="article" on the nav switches them (script below). -->
    <div class="grid min-w-0 overflow-hidden">
      <ul
        data-nav-list
        class="relative isolate col-start-1 row-start-1 flex min-w-0 items-center gap-0.5 overflow-x-auto transition-transform duration-(--motion-duration-nav-pill) ease-(--motion-ease-nav-pill) [scrollbar-width:none] group-data-[mode=article]/nav:-translate-y-full motion-reduce:transition-none"
      >
        {/* The one shared pill, behind the items (z-0 under their z-10, in this isolated list).
          Hidden until the first hover / focus / press: until then the current item shows its own
          background (plain CSS, see NavItem), so a page load measures nothing and animates
          nothing. On that first interaction the pill takes over in the same frame (identical
          pixels), then slides. Positioned with --pill-x / --pill-w by the script below.
          It animates left + width, not translate: a translate animation gets its own compositing
          layer, and iOS Safari drew that layer over the item text (inside this scrolling list). */}
        <li
          aria-hidden="true"
          data-nav-pill
          class="pointer-events-none absolute top-0 left-(--pill-x) z-0 h-8 w-(--pill-w) rounded-xs bg-interactive-secondary-active opacity-0 transition-[left,width,opacity] duration-(--motion-duration-nav-pill) ease-(--motion-ease-nav-pill) data-instant:transition-none data-visible:opacity-100 motion-reduce:transition-none"
        ></li>
        {items.map((item) => (
          <li>
            <NavItem href={item.href} active={isActive(item.href)}>
              {item.label}
            </NavItem>
          </li>
        ))}
      </ul>
      {article && (
        <div
          data-nav-article
          inert
          class="col-start-1 row-start-1 flex h-8 w-0 min-w-full translate-y-full items-center justify-between gap-2 px-1 transition-transform duration-(--motion-duration-nav-pill) ease-(--motion-ease-nav-pill) group-data-[mode=article]/nav:translate-y-0 motion-reduce:transition-none"
        >
          {article.newer?.slug ? (
            <a
              href={`/journal/${article.newer.slug}`}
              rel="prev"
              aria-label={`Newer article: ${article.newer.title}`}
              class={cn(arrow, arrowLink, "text-fg-primary")}
            >
              <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d={chevron.left} stroke="currentColor" stroke-width="1.5" />
              </svg>
            </a>
          ) : (
            <span aria-hidden="true" class={cn(arrow, "text-fg-secondary")}>
              <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d={chevron.left} stroke="currentColor" stroke-width="1.5" />
              </svg>
            </span>
          )}
          <span class="min-w-0 truncate text-center text-label text-fg-primary">
            {article.title}
          </span>
          {article.older?.slug ? (
            <a
              href={`/journal/${article.older.slug}`}
              rel="next"
              aria-label={`Older article: ${article.older.title}`}
              class={cn(arrow, arrowLink, "text-fg-primary")}
            >
              <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d={chevron.right} stroke="currentColor" stroke-width="1.5" />
              </svg>
            </a>
          ) : (
            <span aria-hidden="true" class={cn(arrow, "text-fg-secondary")}>
              <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d={chevron.right} stroke="currentColor" stroke-width="1.5" />
              </svg>
            </span>
          )}
        </div>
      )}
    </div>
  </nav>
  {/* Inline and right after the list, so the pill is under the current item before the first
      paint (no flash, nothing to measure later on a View Transition's first frame). */}
  {article && <script is:inline>
    // Journal article, every breakpoint (as on bakkenbaeck.com):
    // - scrolling down shows the article bar (past the first 80px);
    // - scrolling up brings the nav items back, but only once the page has been scrolled at least
    //   100px, so a nudge or the iOS bounce at the top doesn't switch it;
    // - arriving from an article arrow keeps the article bar from the first frame (set before
    //   paint, no slide), until the reader scrolls up.
    // Small movements are ignored (momentum tails, the iOS address bar). The hidden layer is inert.
    (() => {
      const nav = document.querySelector('nav[aria-label="Main"]');
      const list = nav?.querySelector("[data-nav-list]");
      const bar = nav?.querySelector("[data-nav-article]");
      if (!nav || !list || !bar) return;
      let article = false;
      const set = (on) => {
        if (on === article) return;
        article = on;
        if (on) nav.dataset.mode = "article";
        else delete nav.dataset.mode;
        list.inert = on;
        bar.inert = !on;
      };
      // An arrow click marks the next page, which then opens in article mode.
      let fromArrow = false;
      try {
        fromArrow = sessionStorage.getItem("navArticleMode") === location.pathname;
        sessionStorage.removeItem("navArticleMode");
      } catch {
        /* Storage blocked: open with the nav items. */
      }
      if (fromArrow) set(true);
      bar.addEventListener("click", (event) => {
        const link = event.target.closest("a[href]");
        if (!link) return;
        try {
          sessionStorage.setItem("navArticleMode", link.pathname);
        } catch {
          /* Storage blocked: the next page opens with the nav items. */
        }
      });

      let lastY = scrollY;
      let furthest = scrollY;
      addEventListener(
        "scroll",
        () => {
          const y = scrollY;
          furthest = Math.max(furthest, y);
          if (Math.abs(y - lastY) < 8) return;
          if (y > lastY) {
            if (y >= 80) set(true);
          } else if (furthest >= 100) {
            set(false);
          }
          lastY = y;
        },
        { passive: true },
      );
      addEventListener("pageshow", (event) => event.persisted && set(false));
    })();
  </script>}
  <script is:inline>
    (() => {
      const list = document.querySelector("[data-nav-list]");
      const pill = list?.querySelector("[data-nav-pill]");
      if (!list || !pill) return;
      const items = [...list.querySelectorAll("[data-slot=nav-item]")];
      const active = items.find((item) => item.getAttribute("aria-current") === "page");
      let target = null;
      let live = false;

      // Fractional (getBoundingClientRect, not offsetLeft / offsetWidth, which round), so the
      // pill lands exactly on the current item's own background when it takes over.
      const measure = (item) => {
        const box = item.getBoundingClientRect();
        const origin = list.getBoundingClientRect().left - list.scrollLeft;
        pill.style.setProperty("--pill-x", `${box.left - origin}px`);
        pill.style.setProperty("--pill-w", `${box.width}px`);
      };
      // Put the pill on an item with no transition at all, committed before anything else moves.
      const jump = (item) => {
        pill.dataset.instant = "";
        measure(item);
        void pill.offsetWidth;
        delete pill.dataset.instant;
      };
      // Slide the pill to an item (null hides it). From hidden it appears on the item and fades in.
      // Where the pill is right now (mid-slide included), relative to the list.
      const current = () => {
        const box = pill.getBoundingClientRect();
        const origin = list.getBoundingClientRect().left - list.scrollLeft;
        return { x: box.left - origin, w: box.width };
      };
      // The latest slide: from, to and start time (carried over to the next page, see below).
      let slide = null;
      // A slide carried over from the previous page (Web Animations API), while it runs.
      let carried = null;
      // Stop the carried-over slide where it is, so a new move starts from that exact spot.
      const settle = () => {
        if (!carried) return;
        const here = current();
        carried.cancel();
        carried = null;
        pill.dataset.instant = "";
        pill.style.setProperty("--pill-x", `${here.x}px`);
        pill.style.setProperty("--pill-w", `${here.w}px`);
        void pill.offsetWidth;
        delete pill.dataset.instant;
      };
      const show = (item) => {
        // Already on (or sliding to) this item: let the slide finish.
        if (item && item === target && "visible" in pill.dataset) return;
        settle();
        target = item;
        if (!item) return delete pill.dataset.visible;
        const appearing = !("visible" in pill.dataset);
        if (appearing) jump(item);
        const from = current();
        measure(item);
        pill.dataset.visible = "";
        const box = item.getBoundingClientRect();
        const origin = list.getBoundingClientRect().left - list.scrollLeft;
        slide = appearing
          ? null
          : { fromX: from.x, fromW: from.w, toX: box.left - origin, toW: box.width, t: Date.now() };
      };
      // First interaction: the pill replaces the current item's own background in the same frame.
      const engage = () => {
        if (live) return;
        live = true;
        if (!active) return;
        pill.dataset.instant = "";
        measure(active);
        pill.dataset.visible = "";
        void pill.offsetWidth;
        delete pill.dataset.instant;
        active.dataset.pillLive = "";
        target = active;
      };

      // Only once the fonts are ready: measured in the fallback font, the pill would be a few px
      // off and snap when Graphik lands. That happened right after a navigation, when the browser
      // reports the pointer (still over the clicked item) entering before the font is decoded.
      let fontsReady = document.fonts?.status !== "loading";
      let pending = null;
      document.fonts?.ready.then(() => {
        fontsReady = true;
        if (pending) {
          engage();
          show(pending);
          pending = null;
        }
      });
      const moveTo = (item) => {
        if (!fontsReady) return void (pending = item);
        engage();
        show(item);
      };
      // Touch moves the pill only from the click. iOS Safari treats a tap whose touch-start or
      // hover handlers change what's on screen as a hover and fires no click, so moving the pill
      // on pointerenter / pointerdown for touch sometimes swallowed the tap (pill moved, no
      // navigation).
      let touch = false;
      for (const item of items) {
        for (const type of ["pointerenter", "pointerdown"]) {
          item.addEventListener(type, (event) => {
            touch = event.pointerType === "touch";
            if (!touch) moveTo(item);
          });
        }
        item.addEventListener("focus", () => touch || moveTo(item));
      }
      // Back to the current item when a mouse leaves or focus moves out. Not after a touch: the
      // tap is about to navigate, so the pill stays on the tapped item.
      list.addEventListener("pointerleave", (event) => {
        if (event.pointerType === "touch") return;
        pending = null;
        if (live) show(active ?? null);
      });
      list.addEventListener("focusout", (event) => {
        if (live && !list.contains(event.relatedTarget) && !list.matches(":hover"))
          show(active ?? null);
      });
      // Keep it aligned if the layout changes while it's showing.
      // Only on a real size change: a ResizeObserver also fires once when it starts observing,
      // which snapped an in-flight slide (e.g. the one resumed on the next page) to its end.
      let listSize = "";
      new ResizeObserver(([entry]) => {
        const size = `${entry.contentRect.width}x${entry.contentRect.height}`;
        const changed = listSize !== "" && size !== listSize;
        listSize = size;
        if (changed && live && target) jump(target);
      }).observe(list);

      // Hand the slide over to the next page. A quick click can navigate while the pill is still
      // a few px short of the item; the next page drew the item in its final place, so the pill
      // snapped. The old page saves where the pill is as it goes away; the next page starts it
      // there and finishes the slide.
      // A click or tap starts the slide here and navigates once it has visibly arrived: at 75% of
      // the slide the ease-out curve has covered 99.7% of the way (under 1px on the longest
      // move). Navigating earlier showed on iPhone: Safari freezes the old page from the moment the
      // navigation starts until the next one is ready (~170ms), so the pill stopped short and then
      // snapped. The next page plays what's left of the same slide (Web Animations API, same
      // duration and easing) from the elapsed time. Clock-based (Date.now), so it doesn't depend
      // on when or how the old page goes away.
      const raw = getComputedStyle(document.documentElement)
        .getPropertyValue("--motion-duration-nav-pill")
        .trim(); // the minified CSS writes 400ms as ".4s"
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const duration = reduce ? 0 : (parseFloat(raw) || 0.4) * (raw.endsWith("ms") ? 1 : 1000);
      const headStart = duration * 0.75;
      const easing =
        getComputedStyle(document.documentElement)
          .getPropertyValue("--motion-ease-nav-pill")
          .trim() || "ease-out";
      let navigation = 0;
      const carryOver = () => {
        let saved = null;
        try {
          saved = JSON.parse(sessionStorage.getItem("navPill") ?? "null");
          sessionStorage.removeItem("navPill");
        } catch {
          return;
        }
        if (!saved || !active || saved.to !== active.pathname) return;
        const elapsed = Date.now() - saved.t;
        if (elapsed < 0 || elapsed >= duration) return; // it had already arrived
        // Before the first paint: the pill takes over from the item's own background, resting on
        // the target, with the rest of the slide playing on top of that.
        live = true;
        target = active;
        pill.dataset.instant = "";
        pill.style.setProperty("--pill-x", `${saved.toX}px`);
        pill.style.setProperty("--pill-w", `${saved.toW}px`);
        pill.dataset.visible = "";
        void pill.offsetWidth;
        delete pill.dataset.instant;
        active.dataset.pillLive = "";
        carried = pill.animate(
          [
            { left: `${saved.fromX}px`, width: `${saved.fromW}px` },
            { left: `${saved.toX}px`, width: `${saved.toW}px` },
          ],
          { duration, easing },
        );
        carried.currentTime = elapsed;
        carried.onfinish = () => (carried = null);
      };
      carryOver();

      // A click or tap makes that item current straight away: its text turns primary and the
      // current item's secondary (they fade, see NavItem) while the pill slides; the next page
      // opens with the same colours. Not for a modified click (new tab / window).
      list.addEventListener("click", (event) => {
        const item = event.target.closest("[data-slot=nav-item]");
        if (!item || item === active || event.defaultPrevented) return;
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
          return;
        event.preventDefault();
        for (const other of items) delete other.dataset.entering;
        item.dataset.entering = "";
        if (active) active.dataset.leaving = "";
        moveTo(item);
        const left = slide && target === item ? duration - (Date.now() - slide.t) : 0;
        clearTimeout(navigation);
        navigation = setTimeout(
          () => {
            if (slide && target === item)
              sessionStorage.setItem("navPill", JSON.stringify({ to: item.pathname, ...slide }));
            location.assign(item.href);
          },
          Math.max(0, Math.min(left, headStart)),
        );
      });
      // Back / forward cache: the page comes back as it was left, so reset to the load state.
      addEventListener("pageshow", (event) => {
        if (!event.persisted) return;
        live = false;
        target = null;
        clearTimeout(navigation);
        carried?.cancel();
        carried = null;
        delete pill.dataset.visible;
        for (const item of items) {
          delete item.dataset.entering;
          delete item.dataset.leaving;
          delete item.dataset.pillLive;
        }
      });
    })();
  </script>

  <!-- One button for every breakpoint. On base its wrapper covers the dynamic viewport (h-dvh)
       and pins it to the bottom centre; from md it sits in the header row. -->
  <div class="pointer-events-none fixed inset-x-0 top-0 flex h-dvh items-end justify-center p-4 md:static md:h-auto md:p-0">
    <!-- Keep clear of the iOS home indicator (no token for a device inset). -->
    <div class="pointer-events-auto mb-[env(safe-area-inset-bottom)] view-transition-header-action md:mb-0">
      <!-- The "Get in touch" button is the dialog's trigger, rendered by the modal. -->
      <GetInTouchModal />
    </div>
  </div>
</header>
