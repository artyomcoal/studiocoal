---
/**
 * Media
 * One Work visual from the shared Sanity `media` object: a responsive Sanity image or a
 * Bunny Stream HLS video, cropped to 4:5 (portrait) or 16:9 (landscape) around the hotspot.
 * "hero" is art-directed: 4:5 below md, 16:9 from md (Work Single › Featured Media).
 * Figma: https://www.figma.com/design/xqG6nM7oVW4iev0PrbuqWt/?node-id=2743-34179
 *
 * Images: srcset/sizes from the URL builder, LQIP blur behind the image, explicit dimensions.
 * Videos: the poster is a regular responsive <img>; the <video> sits on top. Without an
 *   uploaded poster, Bunny's own thumbnail is used (src/lib/bunny.ts), resized at build time
 *   to a srcset of small WebPs (src/pages/posters/[file].ts); until it loads, or if Bunny has
 *   none, the wrapper shows its bg-secondary background.
 * - Safari (and other browsers with native HLS) get the playlist as `src`.
 * - Everywhere else, hls.js/light is dynamic-imported, only once a video is within one
 *   viewport of the screen. Pages without video, and native-HLS browsers, never load it.
 * - Every video gets the site's one control, VideoControl (no browser-default controls).
 * - "ambient" videos autoplay muted and looped while on screen, can be paused (WCAG 2.2.2) and
 *   don't autoplay under prefers-reduced-motion.
 * - "player" videos start paused (Play shown), play with sound and their first caption track
 *   on, and only load segments once played.
 * Code-defined videos (`video` prop, e.g. the home showreels in src/lib/showreels.ts) are
 *   Bunny playlists played as "ambient", with Bunny's thumbnail as the poster.
 */
import {
  bunnyPosterPath,
  bunnyPosterSrcSet,
  bunnyThumbnailCandidates,
  resolveBunnyThumbnail,
} from "@/lib/bunny";
import { ASPECT, type AspectName } from "@/lib/media";
import type { Showreel } from "@/lib/showreels";
import VideoControl from "@/components/VideoControl.astro";
import { cn } from "@/lib/utils";
import { imageSrcSet, urlFor } from "@/sanity/image";
import { bunnyPosters } from "@/sanity/posters";
import { resolveMedia, type MediaData } from "@/sanity/media";

interface Props {
  /** A Sanity visual. */
  media?: MediaData | null;
  /** A Bunny video defined in code instead (ambient playback). Ignored when `media` resolves. */
  video?: Showreel | null;
  /** Crop: portrait 4:5, landscape 16:9, square 1:1, thumbnail 4:3, hero 4:5 → 16:9 at md. */
  aspect: AspectName | "hero";
  /** The `sizes` attribute: how wide the visual renders at each breakpoint. */
  sizes: string;
  /** LCP visual: load eagerly with high fetch priority. */
  priority?: boolean;
  class?: string;
}

const { media, video: codeVideo, aspect, sizes, priority = false, class: className } = Astro.props;

const resolved = resolveMedia(media);
// Base crop. A hero adds a 16:9 <source> from md.
const base: AspectName = aspect === "hero" ? "portrait" : aspect;
const ratio = ASPECT[base];
// Intrinsic size for width/height attributes (no layout shift); the CSS aspect box wins.
const width = { portrait: 1600, landscape: 1920, square: 1600, thumbnail: 800, gallery: 2048 }[
  base
];
const height = Math.round(width / ratio);

const image = resolved?.kind === "image" ? resolved.image : resolved?.video.poster;
const video =
  resolved?.kind === "video"
    ? resolved.video
    : !resolved && codeVideo?.playlistUrl
      ? {
          playlistUrl: codeVideo.playlistUrl,
          playback: "ambient" as const,
          alt: null,
          poster: null,
        }
      : null;
const alt = resolved?.kind === "image" ? (resolved.image.alt ?? "") : "";
// No uploaded poster: Bunny's thumbnail (checked at build time; null if Bunny has none).
const bunnyPoster =
  video && !image?.asset
    ? await resolveBunnyThumbnail(video.playlistUrl, String(Astro.site ?? Astro.url.origin))
    : null;
// If the chosen thumbnail fails in the browser anyway (Bunny's CDN can keep serving a cached
// 404 for a while after it's created), swap to the first generated frame.
const bunnyFallback = bunnyThumbnailCandidates(video?.playlistUrl).find(
  (url) => url !== bunnyPoster,
);
// The same thumbnail resized at build time (src/pages/posters/[file].ts): a srcset of small
// WebPs instead of the ~23 MB full-size frame. Prerendered pages only: a server-rendered draft
// preview can show a video published after the last build, whose files don't exist yet.
const resizedPoster =
  bunnyPoster && video?.playlistUrl && Astro.isPrerendered
    ? (await bunnyPosters()).get(video.playlistUrl)
    : undefined;
const resized = resizedPoster?.thumbnail === bunnyPoster ? resizedPoster : undefined;
const playerPoster =
  video?.playback === "player"
    ? image?.asset
      ? urlFor(image)
          .width(1920)
          .height(Math.round(1920 / (aspect === "hero" ? ASPECT.landscape : ASPECT[aspect])))
          .fit("crop")
          .url()
      : resized
        ? bunnyPosterPath(resized.videoId, 1440)
        : (bunnyPoster ?? undefined)
    : undefined;
---

<div
  data-slot="media"
  data-playback={video?.playback}
  data-paused={video?.playback === "player" ? "" : undefined}
  class={cn(
    "group/media relative overflow-hidden rounded-sm bg-bg-secondary",
    {
      portrait: "aspect-4/5",
      landscape: "aspect-video",
      square: "aspect-square",
      thumbnail: "aspect-4/3",
      gallery: "aspect-3/2",
      hero: "aspect-4/5 md:aspect-video",
    }[aspect],
    className,
  )}
>
  {image?.asset && (
    <picture>
      {aspect === "hero" && (
        <source
          media="(min-width: 48rem)"
          srcset={imageSrcSet(image, ASPECT.landscape)}
          sizes={sizes}
          width={1920}
          height={1080}
        />
      )}
      <img
        src={urlFor(image)
          .width(1024)
          .height(Math.round(1024 / ratio))
          .fit("crop")
          .url()}
        srcset={imageSrcSet(image, ratio)}
        sizes={sizes}
        width={width}
        height={height}
        alt={alt}
        loading={priority ? "eager" : "lazy"}
        decoding={priority ? "sync" : "async"}
        fetchpriority={priority ? "high" : "auto"}
        class="absolute inset-0 size-full bg-cover object-cover"
        style={image.lqip ? `background-image: url(${image.lqip})` : undefined}
      />
    </picture>
  )}
  {bunnyPoster && (
    <img
      src={resized ? bunnyPosterPath(resized.videoId, 960) : bunnyPoster}
      srcset={resized ? bunnyPosterSrcSet(resized.videoId) : undefined}
      sizes={resized ? sizes : undefined}
      data-bunny-fallback={resized ? undefined : bunnyFallback}
      width={width}
      height={height}
      alt=""
      loading={priority ? "eager" : "lazy"}
      decoding={priority ? "sync" : "async"}
      fetchpriority={priority ? "high" : "auto"}
      class="absolute inset-0 size-full object-cover"
    />
  )}
  {video && (
    <>
      {/* eslint-disable-next-line astro/jsx-a11y/media-has-caption -- ambient videos are muted
            and silent; player videos carry captions as subtitle tracks in the HLS playlist. */}
      <video
        data-src={video.playlistUrl}
        data-playback={video.playback}
        class:list={[
          "absolute inset-0 size-full object-cover",
          video.playback === "ambient" &&
            "opacity-0 transition-opacity duration-300 group-data-playing/media:opacity-100",
        ]}
        poster={playerPoster}
        preload="none"
        playsinline
        muted={video.playback === "ambient"}
        loop={video.playback === "ambient"}
        aria-label={video.alt || undefined}
        aria-hidden={!video.alt && video.playback === "ambient" ? "true" : undefined}
      />
      <VideoControl label={video.playback === "player" ? "Play video" : "Pause video"} />
    </>
  )}
</div>

<script>
  // Bunny poster that failed to load (e.g. a CDN still caching a 404 for a new thumbnail):
  // swap to the first generated frame. Covers images that failed before this script ran.
  document.querySelectorAll<HTMLImageElement>("img[data-bunny-fallback]").forEach((img) => {
    const swap = () => {
      const fallback = img.dataset.bunnyFallback;
      delete img.dataset.bunnyFallback;
      if (fallback && img.src !== fallback) img.src = fallback;
    };
    if (img.complete && img.naturalWidth === 0) swap();
    else img.addEventListener("error", swap, { once: true });
  });

  const HLS_TYPE = "application/vnd.apple.mpegurl";
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  /** Gives the <video> its source: native HLS when supported, hls.js/light otherwise. */
  async function attach(video: HTMLVideoElement) {
    const src = video.dataset.src;
    if (!src || video.dataset.attached !== undefined) return;
    video.dataset.attached = "";

    if (video.canPlayType(HLS_TYPE)) {
      video.src = src;
      return;
    }
    const { default: Hls } = await import("hls.js/light");
    if (!Hls.isSupported()) {
      video.src = src; // Let the browser try; the poster stays visible if it can't.
      return;
    }
    const player = video.dataset.playback === "player";
    const hls = new Hls({ capLevelToPlayerSize: true, autoStartLoad: !player });
    if (player) video.addEventListener("play", () => hls.startLoad(), { once: true });
    hls.loadSource(src);
    hls.attachMedia(video);
    // Play may have been requested before the source existed.
    if (video.dataset.wantsPlay !== undefined) void start(video);
  }

  function root(video: HTMLVideoElement) {
    return video.closest<HTMLElement>("[data-slot=media]")!;
  }

  /** Autoplay refused (iOS Low Power Mode, data saver, browser settings): show Play, so the
   * video doesn't sit on its poster behind a Pause button. A tap is a user gesture, so Play
   * then works. Other rejections (AbortError when pause() interrupts a load) are ignored. */
  function playFailed(video: HTMLVideoElement, error: unknown) {
    if (error instanceof DOMException && error.name === "NotAllowedError") {
      delete video.dataset.wantsPlay;
      setPaused(video, true);
    }
  }

  function start(video: HTMLVideoElement) {
    return video.play().catch((error: unknown) => playFailed(video, error));
  }

  function play(video: HTMLVideoElement) {
    video.dataset.wantsPlay = "";
    if (video.currentSrc || video.src) void start(video);
    else void attach(video).then(() => start(video));
  }

  function pause(video: HTMLVideoElement) {
    delete video.dataset.wantsPlay;
    video.pause();
  }

  /** User pause (button), reduced motion or refused autoplay: shows the Play state on the toggle. */
  function setPaused(video: HTMLVideoElement, paused: boolean) {
    const el = root(video);
    el.toggleAttribute("data-paused", paused);
    el.querySelector("[data-slot=media-toggle]")?.setAttribute(
      "aria-label",
      paused ? "Play video" : "Pause video",
    );
  }

  const videos = [...document.querySelectorAll<HTMLVideoElement>("video[data-src]")];
  if (videos.length) {
    // Attach (and, with hls.js, start buffering) one viewport ahead of the screen.
    const nearby = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          nearby.unobserve(entry.target);
          void attach(entry.target as HTMLVideoElement);
        }
      },
      { rootMargin: "100% 0px" },
    );

    // Ambient videos play only while visible and not paused by the user.
    const visible = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          const userPaused = root(video).hasAttribute("data-paused");
          if (entry.isIntersecting && !userPaused) play(video);
          else pause(video);
        }
      },
      { threshold: 0.25 },
    );

    for (const video of videos) {
      nearby.observe(video);
      const toggle = root(video).querySelector("[data-slot=media-toggle]");

      if (video.dataset.playback === "player") {
        // Player: Play starts it with sound and turns on its first caption track; it shows Play
        // again when paused or finished.
        toggle?.addEventListener("click", () => {
          if (video.paused) {
            const captions = [...video.textTracks].find(
              (track) => track.kind === "subtitles" || track.kind === "captions",
            );
            if (captions && captions.mode === "disabled") captions.mode = "showing";
            setPaused(video, false);
            play(video);
          } else pause(video);
        });
        video.addEventListener("pause", () => setPaused(video, true));
        video.addEventListener("ended", () => setPaused(video, true));
        video.addEventListener("play", () => setPaused(video, false));
        continue;
      }
      if (video.dataset.playback !== "ambient") continue;

      video.addEventListener("playing", () => root(video).setAttribute("data-playing", ""));
      if (reducedMotion.matches) setPaused(video, true);
      visible.observe(video);

      toggle?.addEventListener("click", () => {
        const paused = !root(video).hasAttribute("data-paused");
        setPaused(video, paused);
        if (paused) pause(video);
        else play(video);
      });
    }
  }
</script>
