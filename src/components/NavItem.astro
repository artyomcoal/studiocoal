---
/**
 * Nav Item
 * Figma: https://www.figma.com/design/xqG6nM7oVW4iev0PrbuqWt/?node-id=704-3403
 *
 * One link in the Navbar. Its background is the Navbar's one shared pill (data-nav-pill), which
 * slides under the hovered / focused / pressed item. Until the first interaction the current
 * item shows the same background itself (plain CSS); the pill then takes over (data-pill-live).
 * Text: Default fg-secondary, Active = current page (aria-current="page") fg-primary. Hover and
 * focus never change the text colour. A click or tap does, at once: the Navbar's script sets
 * data-entering on the clicked item (primary) and data-leaving on the current one
 * (secondary), so the colours fade over while the next page loads.
 * Focus keeps the FocusState ring.
 */
import { cva } from "class-variance-authority";
import { cn } from "@/lib/utils";

interface Props {
  href: string;
  /** Current page (or a page inside this section). */
  active?: boolean;
  class?: string;
}

const { href, active = false, class: className } = Astro.props;

const navItemVariants = cva(
  [
    // relative: painted above the pill, which comes before the items in the list.
    "relative z-10 flex h-8 shrink-0 items-center rounded-xs p-2 text-label whitespace-nowrap",
    // The current item's own background, until the Navbar's shared pill takes over
    // (data-pill-live). Plain CSS, so the first paint needs no script or measuring.
    "aria-[current=page]:not-data-pill-live:bg-interactive-secondary-active",
    // Text colour only: the background hand-over to the pill must be instant.
    "transition-[color] duration-150 ease-out outline-none",
    "focus-visible:ring-2 focus-visible:ring-interactive-focus-ring focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary",
    "data-entering:text-fg-primary data-leaving:text-fg-secondary",
  ],
  {
    variants: {
      active: {
        true: "text-fg-primary",
        false: "text-fg-secondary",
      },
    },
  },
);
---

<a
  href={href}
  aria-current={active ? "page" : undefined}
  data-slot="nav-item"
  class={cn(navItemVariants({ active }), className)}
>
  <slot />
</a>
