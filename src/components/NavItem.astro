---
/**
 * Nav Item
 * Figma: https://www.figma.com/design/xqG6nM7oVW4iev0PrbuqWt/?node-id=704-3403
 *
 * One link in the Navbar. Text only: the background is the Navbar's one shared pill
 * (data-nav-pill), which slides under the hovered / focused / current item.
 * Text: Default fg-secondary, Active = current page (aria-current="page") fg-primary. Hover and
 * focus never change the text colour. After a navigation the colours hand over once the page
 * transition ends: data-entering (new current item, still secondary) and data-leaving (previous
 * one, still primary) are set by the Navbar's script and then removed, so the colours fade.
 * Focus keeps the FocusState ring.
 */
import { cva } from "class-variance-authority";
import { cn } from "@/lib/utils";

interface Props {
  href: string;
  /** Current page (or a page inside this section). */
  active?: boolean;
  class?: string;
}

const { href, active = false, class: className } = Astro.props;

const navItemVariants = cva(
  [
    // relative: painted above the pill, which comes before the items in the list.
    "relative flex h-8 shrink-0 items-center rounded-xs p-2 text-label whitespace-nowrap",
    "transition-colors duration-150 ease-out outline-none",
    "focus-visible:ring-2 focus-visible:ring-interactive-focus-ring focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary",
    "data-entering:text-fg-secondary data-leaving:text-fg-primary",
  ],
  {
    variants: {
      active: {
        true: "text-fg-primary",
        false: "text-fg-secondary",
      },
    },
  },
);
---

<a
  href={href}
  aria-current={active ? "page" : undefined}
  data-slot="nav-item"
  class={cn(navItemVariants({ active }), className)}
>
  <slot />
</a>
