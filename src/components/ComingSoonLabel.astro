---
/**
 * Coming Soon Label
 * Marks the visual of a project whose case study isn't ready yet (Work › "Case study coming
 * soon"). Pinned to the top-left corner of the visual, 16px in from both edges; the parent must
 * be positioned. Figma "Button" (Coming soon), node 53795:5883.
 * Figma: https://www.figma.com/design/xqG6nM7oVW4iev0PrbuqWt/?node-id=53795-5883
 *
 * Theme tokens, as in Figma: box bg-translucent with background blur md, label
 * fg-primary in Body XS, so it follows the light / dark theme. Decorative (aria-hidden): cards say
 * "coming soon" to screen readers in their title.
 */
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span
  aria-hidden="true"
  class={cn(
    "pointer-events-none absolute top-4 left-4 z-10 rounded-xs bg-bg-translucent px-2 py-1 text-body-xs whitespace-nowrap text-fg-primary backdrop-blur-md",
    className,
  )}
>
  Coming soon
</span>
