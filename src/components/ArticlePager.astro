---
/**
 * Article Pager
 * End-of-article navigation to the previous (newer) and next (older) article. Two tiles, side
 * by side from md; "Next" always sits in the right-hand column, even when it's alone.
 * Renders nothing when there is neither.
 * Figma: no node. Built for the article page (Article Template, frame 5068:9132).
 */
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { cn } from "@/lib/utils";

interface Link {
  title: string;
  slug: string;
}

interface Props {
  previous: Link | null;
  next: Link | null;
  class?: string;
}

const { previous, next, class: className } = Astro.props;

const tile =
  "group flex min-h-32 flex-col justify-between gap-6 rounded-sm bg-bg-secondary p-4 text-fg-primary transition-colors outline-none hover:bg-bg-tertiary focus-visible:ring-2 focus-visible:ring-interactive-focus-ring focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary md:p-5";
const arrow = "size-4 shrink-0 transition-transform motion-reduce:transition-none";
---

{(previous || next) && (
  <nav aria-label="More articles" class={cn("grid gap-gutter md:grid-cols-2", className)}>
    {previous && (
      <a href={`/journal/${previous.slug}`} rel="prev" class={tile}>
        <span class="text-eyebrow text-fg-secondary uppercase">Previous article</span>
        <span class="flex items-end gap-2 text-headline-sm">
          <ArrowLeft aria-hidden="true" class={cn(arrow, "group-hover:-translate-x-0.5")} />
          <span>{previous.title}</span>
        </span>
      </a>
    )}
    {next && (
      <a
        href={`/journal/${next.slug}`}
        rel="next"
        class={cn(tile, "md:col-start-2 md:items-end md:text-right")}
      >
        <span class="text-eyebrow text-fg-secondary uppercase">Next article</span>
        <span class="flex items-end gap-2 text-headline-sm md:justify-end">
          <span>{next.title}</span>
          <ArrowRight aria-hidden="true" class={cn(arrow, "group-hover:translate-x-0.5")} />
        </span>
      </a>
    )}
  </nav>
)}
