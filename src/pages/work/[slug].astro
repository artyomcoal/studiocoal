---
/**
 * Work Single page: project hero, details (intro, tags, challenge / solution / outcome,
 * results), project content visuals and recent work.
 * Figma: Work Single / breakpoint=xl|md|base (frames 5044:18541, 53350:12638, 53350:12880)
 */
import { sanityClient } from "sanity:client";
import Media from "@/components/Media.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { resolveBunnyThumbnail } from "@/lib/bunny";
import { ASPECT } from "@/lib/media";
import { canonicalUrl, contentPath, contentSeo } from "@/lib/seo";
import { serviceTitle } from "@/lib/services";
import { socialImagePath, socialImagesEnabled } from "@/lib/social-image";
import { breadcrumbs, project } from "@/lib/structured-data";
import { imageSrcSet, urlFor } from "@/sanity/image";
import { resolveMedia } from "@/sanity/media";
import { RECENT_WORK_QUERY, WORK_QUERY, WORK_SLUGS_QUERY } from "@/sanity/queries";
import FeaturedWorkSection from "@/sections/FeaturedWorkSection.astro";
import WorkDetailsSection from "@/sections/WorkDetailsSection.astro";

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch(WORK_SLUGS_QUERY);
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const [work, recentWork] = await Promise.all([
  sanityClient.fetch(WORK_QUERY, { slug }),
  sanityClient.fetch(RECENT_WORK_QUERY, { slug, limit: 3 }),
]);
// Paths come from the same dataset, so a missing project means the build raced a delete.
if (!work) throw new Error(`Work "${slug}" not found`);

// The hero image (or video poster) is the LCP element: preload both art-directed crops.
const hero = resolveMedia(work.heroMedia);
const heroImage = hero?.kind === "image" ? hero.image : hero?.video.poster;
const heroSizes = "100vw";
const site = String(Astro.site ?? Astro.url.origin);
// A hero video without an uploaded poster shows Bunny's thumbnail instead (Media.astro).
const heroBunnyPoster =
  hero?.kind === "video" && !heroImage?.asset
    ? await resolveBunnyThumbnail(hero.video.playlistUrl, site)
    : null;

// Social image: SEO › Social image, else the generated card (title over the listing visual,
// src/pages/og/), else the listing visual, then the hero (a video's poster, or Bunny's
// thumbnail when it has none).
const socialSource = resolveMedia(work.listingMedia) ?? hero;
const visual = socialSource?.kind === "image" ? socialSource.image : socialSource?.video.poster;
const ogImage = work.seo?.image?.asset
  ? urlFor(work.seo.image).width(1200).height(630).fit("crop").url()
  : socialImagesEnabled() && work.slug
    ? new URL(socialImagePath("work", work.slug), site).href
    : visual?.asset
      ? urlFor(visual).width(1200).height(630).fit("crop").url()
      : socialSource?.kind === "video"
        ? await resolveBunnyThumbnail(socialSource.video.playlistUrl, site)
        : null;

// Search description falls back to the short description, which fits Google's length best.
const seo = contentSeo({ ...work, excerpt: work.summary ?? work.excerpt });
const url = canonicalUrl(contentPath("work", work.slug ?? slug), site);
const jsonLd = [
  project({
    site,
    url,
    title: work.title ?? "",
    description: seo.description,
    image: ogImage,
    client: work.client,
    year: work.year,
    keywords: [...(work.services ?? []).map(serviceTitle), ...(work.industry ?? [])],
    updatedAt: work._updatedAt,
  }),
  breadcrumbs([
    ["Home", canonicalUrl("/", site)],
    ["Work", canonicalUrl("/work", site)],
    [work.title ?? "", url],
  ]),
];
---

<PageLayout
  title={seo.title}
  description={seo.description}
  image={ogImage}
  noindex={seo.noindex}
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    {heroImage?.asset && (
      <>
        <link
          rel="preload"
          as="image"
          media="(max-width: 47.99rem)"
          imagesrcset={imageSrcSet(heroImage, ASPECT.portrait)}
          imagesizes={heroSizes}
          fetchpriority="high"
        />
        <link
          rel="preload"
          as="image"
          media="(min-width: 48rem)"
          imagesrcset={imageSrcSet(heroImage, ASPECT.landscape)}
          imagesizes={heroSizes}
          fetchpriority="high"
        />
      </>
    )}
    {heroBunnyPoster && (
      <link rel="preload" as="image" href={heroBunnyPoster} fetchpriority="high" />
    )}
  </Fragment>

  <Media media={work.heroMedia} aspect="hero" sizes={heroSizes} priority class="md:rounded-none" />

  <WorkDetailsSection work={work} />

  {work.content?.length ? (
    <section aria-label="Project visuals" class="flex flex-col gap-2 px-container pb-section">
      {work.content.map((block) =>
        block._type === "mediaPair" && "left" in block ? (
          <div class="flex gap-2">
            <Media media={block.left} aspect="portrait" sizes="50vw" class="flex-1" />
            <Media media={block.right} aspect="portrait" sizes="50vw" class="flex-1" />
          </div>
        ) : block._type === "mediaFullWidth" && "media" in block ? (
          <Media media={block.media} aspect="landscape" sizes="100vw" />
        ) : null,
      )}
    </section>
  ) : null}

  <FeaturedWorkSection works={recentWork} />
</PageLayout>
