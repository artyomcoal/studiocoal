---
/**
 * Services page: hero and one Service Offering section per service.
 * Figma: Services / breakpoint=xl|md|base (frames 5039:8547, 53350:11745, 53350:12293)
 */
import { sanityClient } from "sanity:client";
import PageLayout from "@/layouts/PageLayout.astro";
import { SERVICES, relatedWork } from "@/lib/services";
import {
  SERVICE_DESCRIPTIONS_QUERY,
  SERVICES_WORK_PICKS_QUERY,
  WORK_BY_SERVICE_QUERY,
} from "@/sanity/queries";
import ServiceOfferingSection from "@/sections/ServiceOfferingSection.astro";

// Section bar in the Navbar (Figma 53673:5159): one link per offering. Labels as in Figma
// ("Web", shorter than the service title "Website"); anchors from SERVICES.
const SECTION_LABELS: Record<(typeof SERVICES)[number]["value"], string> = {
  brand: "Brand",
  web: "Web",
  "digital-products": "Product",
};
const sections = {
  label: "Services",
  items: SERVICES.map((service) => ({
    label: SECTION_LABELS[service.value],
    href: `#${service.anchor}` as const,
  })),
};

// Per service: the projects picked in Site settings › Services page, then the newest tagged
// projects for any place left.
const [picks, latest, descriptions] = await Promise.all([
  sanityClient.fetch(SERVICES_WORK_PICKS_QUERY),
  Promise.all(
    SERVICES.map((service) =>
      sanityClient.fetch(WORK_BY_SERVICE_QUERY, { service: service.value }),
    ),
  ),
  sanityClient.fetch(SERVICE_DESCRIPTIONS_QUERY),
]);
const related = SERVICES.map((service, index) =>
  relatedWork(picks?.[service.workField] ?? null, latest[index] ?? []),
);
---

<PageLayout
  title="Services"
  description="Brand, web and product, shaped by one design-led studio to tell one unmistakable story."
  sections={sections}
>
  <section class="px-container pt-hero pb-12">
    <h1 class="text-headline-xxl text-fg-primary">
      <span class="text-fg-tertiary">Services.</span> Brand, web and product, shaped by one
      design-led studio to tell one unmistakable story.
    </h1>
  </section>
  {SERVICES.map((service, index) => (
    <ServiceOfferingSection
      service={service}
      works={related[index] ?? []}
      descriptions={descriptions}
    />
  ))}
</PageLayout>
