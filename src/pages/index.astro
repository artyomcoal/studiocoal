---
import { sanityClient } from "sanity:client";
import PageLayout from "@/layouts/PageLayout.astro";
import { FEATURED_JOURNAL_QUERY, FEATURED_WORK_QUERY } from "@/sanity/queries";
import FeaturedArticlesSection from "@/sections/FeaturedArticlesSection.astro";
import FeaturedWorkSection from "@/sections/FeaturedWorkSection.astro";

const [featuredWork, featuredPosts] = await Promise.all([
  sanityClient.fetch(FEATURED_WORK_QUERY, { limit: 6 }),
  sanityClient.fetch(FEATURED_JOURNAL_QUERY, { limit: 4 }),
]);
---

<PageLayout>
  <section class="px-container pt-hero py-section">
    <p class="text-eyebrow text-fg-primary">STUDIO COAL</p>
    <h1 class="text-headline-xxl text-fg-primary">Site under construction.</h1>
  </section>
  <FeaturedWorkSection works={featuredWork} columns="2" />
  <FeaturedArticlesSection posts={featuredPosts} />
</PageLayout>
