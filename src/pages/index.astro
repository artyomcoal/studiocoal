---
/**
 * Home page.
 * Figma: Homepage / breakpoint=xl|md|base (frames 5039:7455, 53333:8604, 53335:9144)
 */
import { sanityClient } from "sanity:client";
import PageLayout from "@/layouts/PageLayout.astro";
import { HOME_FEATURED_LIMIT, HOME_JOURNAL_LIMIT } from "@/sanity/filters";
import { CLIENTS_QUERY, FEATURED_JOURNAL_QUERY, FEATURED_WORK_QUERY } from "@/sanity/queries";
import ClientsSection from "@/sections/ClientsSection.astro";
import FeaturedArticlesSection from "@/sections/FeaturedArticlesSection.astro";
import FeaturedWorkSection from "@/sections/FeaturedWorkSection.astro";
import HomeHeroSection from "@/sections/HomeHeroSection.astro";
import ServicesOverviewSection from "@/sections/ServicesOverviewSection.astro";

const [featuredWork, clients, featuredPosts] = await Promise.all([
  sanityClient.fetch(FEATURED_WORK_QUERY, { limit: HOME_FEATURED_LIMIT }),
  sanityClient.fetch(CLIENTS_QUERY),
  sanityClient.fetch(FEATURED_JOURNAL_QUERY, { limit: HOME_JOURNAL_LIMIT }),
]);
---

<PageLayout>
  <Fragment slot="head">
    <!-- The hero's rotating words use Geist Mono SemiBold (only on this page). -->
    <link
      rel="preload"
      href="/fonts/geist/GeistMono-SemiBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </Fragment>
  <HomeHeroSection />
  <FeaturedWorkSection works={featuredWork} columns="2" />
  <ServicesOverviewSection />
  <ClientsSection clients={clients} />
  <FeaturedArticlesSection posts={featuredPosts} />
</PageLayout>
