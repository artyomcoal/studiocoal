---
/**
 * Journal article page: header (meta, title, excerpt), 16:9 cover (4px radius), rich text body
 * with an "On this page" list beside it on xl, a previous / next pager and the latest other
 * articles.
 * Figma: Article Template / breakpoint=xl|md|base (frames 5068:9132, 53350:13666, 53350:14038)
 *
 * Columns: header, body and pager share one centred column (base: full, md: 8 of 12,
 * xl: 6 of 12); text inside it stops at a 65ch reading measure (RichText).
 */
import { sanityClient } from "sanity:client";
import ArticlePager from "@/components/ArticlePager.astro";
import ArticleToc from "@/components/ArticleToc.astro";
import Media from "@/components/Media.astro";
import RichText from "@/components/RichText.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { formatDate } from "@/lib/format";
import { ASPECT } from "@/lib/media";
import { outline, readingMinutes } from "@/lib/portableText";
import { canonicalUrl, contentPath, contentSeo } from "@/lib/seo";
import { socialImagePath, socialImagesEnabled } from "@/lib/social-image";
import { article, breadcrumbs } from "@/lib/structured-data";
import { imageSrcSet, urlFor } from "@/sanity/image";
import type { MediaData } from "@/sanity/media";
import { JOURNAL_QUERY, JOURNAL_SLUGS_QUERY, RECENT_JOURNAL_QUERY } from "@/sanity/queries";
import FeaturedArticlesSection from "@/sections/FeaturedArticlesSection.astro";
import { Badge } from "@/ui/badge";

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch(JOURNAL_SLUGS_QUERY);
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const [post, recentPosts] = await Promise.all([
  sanityClient.fetch(JOURNAL_QUERY, { slug }),
  sanityClient.fetch(RECENT_JOURNAL_QUERY, { slug, limit: 4 }),
]);
// Paths come from the same dataset, so a missing post means the build raced a delete.
if (!post) throw new Error(`Journal post "${slug}" not found`);

const body = post.body ?? [];
const headings = outline(body);
const minutes = readingMinutes(body);
/** The centred reading column (header, body, pager). */
const column = "col-span-full md:col-span-8 md:col-start-3 xl:col-span-6 xl:col-start-4";

const cover: MediaData | null = post.coverImage?.asset
  ? { kind: "image", image: post.coverImage, video: null }
  : null;
// The 16:9 cover is the LCP element below the header on large screens: preload it.
const coverSizes = "100vw";
// Social image: SEO › Social image, else the generated card (title over the cover,
// src/pages/og/), else the cover.
const ogImage = post.seo?.image?.asset
  ? urlFor(post.seo.image).width(1200).height(630).fit("crop").url()
  : socialImagesEnabled() && post.slug
    ? new URL(socialImagePath("journal", post.slug), Astro.site ?? Astro.url.origin).href
    : post.coverImage?.asset
      ? urlFor(post.coverImage).width(1200).height(630).fit("crop").url()
      : null;

const seo = contentSeo(post);
const site = String(Astro.site ?? Astro.url.origin);
const url = canonicalUrl(contentPath("journal", post.slug ?? slug), site);
const jsonLd = [
  article({
    site,
    url,
    title: post.title ?? "",
    description: seo.description,
    image: ogImage,
    publishedAt: post.publishedAt,
    updatedAt: post._updatedAt,
    category: post.category,
  }),
  breadcrumbs([
    ["Home", canonicalUrl("/", site)],
    ["Journal", canonicalUrl("/journal", site)],
    [post.title ?? "", url],
  ]),
];
---

<PageLayout
  title={seo.title}
  description={seo.description}
  image={ogImage}
  noindex={seo.noindex}
  ogType="article"
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    {post.coverImage?.asset && (
      <link
        rel="preload"
        as="image"
        imagesrcset={imageSrcSet(post.coverImage, ASPECT.landscape)}
        imagesizes={coverSizes}
      />
    )}
  </Fragment>

  <header class="grid-cols-layout px-container pt-40 pb-12 xl:pb-16">
    <div class={`${column} flex flex-col gap-6 text-fg-primary`}>
      <ul class="flex flex-wrap gap-1" aria-label="Article details">
        {post.category && (
          <li>
            <Badge>{post.category}</Badge>
          </li>
        )}
        <li>
          <Badge>
            <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
          </Badge>
        </li>
        <li>
          <Badge class="normal-case">{minutes} min read</Badge>
        </li>
      </ul>
      <h1 class="text-headline-xxl text-balance">{post.title}</h1>
      {post.excerpt && (
        <p class="max-w-prose text-headline-md text-pretty text-fg-primary">{post.excerpt}</p>
      )}
    </div>
  </header>

  {cover && (
    <div class="px-container">
      <Media media={cover} aspect="landscape" sizes={coverSizes} priority />
    </div>
  )}

  <div class="grid-cols-layout gap-y-16 px-container pt-12 pb-section xl:gap-y-24 xl:pt-16">
    {headings.length > 1 && (
      <aside class="hidden xl:col-span-2 xl:col-start-1 xl:row-start-1 xl:block">
        <ArticleToc headings={headings} class="sticky top-24" />
      </aside>
    )}
    <article class={`${column} xl:row-start-1`}>
      <RichText value={body} />
    </article>
    <ArticlePager previous={post.previous} next={post.next} class={column} />
  </div>

  <FeaturedArticlesSection posts={recentPosts} title="" />
</PageLayout>
