---
/**
 * About page: hero, studio photos, studio (team and approach), capabilities, clients, services CTA
 * and recent work.
 * Figma: About / breakpoint=xl|md|base (frames 5044:17639, 53346:10376, 53347:10697)
 */
import { sanityClient } from "sanity:client";
import PageLayout from "@/layouts/PageLayout.astro";
import type { MediaData } from "@/sanity/media";
import { ABOUT_MEDIA_QUERY, CLIENTS_QUERY, FEATURED_WORK_QUERY } from "@/sanity/queries";
import AboutMarqueeSection from "@/sections/AboutMarqueeSection.astro";
import AboutWhySection from "@/sections/AboutWhySection.astro";
import CapabilitiesSection from "@/sections/CapabilitiesSection.astro";
import ClientsSection from "@/sections/ClientsSection.astro";
import FeaturedWorkSection from "@/sections/FeaturedWorkSection.astro";
import ServicesCtaSection from "@/sections/ServicesCtaSection.astro";

const [aboutMedia, clients, recentWork] = await Promise.all([
  sanityClient.fetch(ABOUT_MEDIA_QUERY),
  sanityClient.fetch(CLIENTS_QUERY),
  sanityClient.fetch(FEATURED_WORK_QUERY, { limit: 3 }),
]);
---

<PageLayout page="about">
  <section class="px-container pt-hero pb-12">
    <h1 class="text-headline-xxl text-fg-primary">
      <span class="text-fg-tertiary">About.</span> Studio Coal is a design partner for founders at a
      turning point. Senior, curious and particular about the details.
    </h1>
  </section>
  <AboutMarqueeSection
    items={(aboutMedia?.gallery ?? []).map(
      (image) => ({ kind: "image", image, video: null }) as MediaData,
    )}
  />
  <AboutWhySection />
  <CapabilitiesSection />
  <ClientsSection clients={clients} />
  <ServicesCtaSection />
  <FeaturedWorkSection works={recentWork} />
</PageLayout>
