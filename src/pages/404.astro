---
/**
 * 404 page.
 * Figma: 404 / breakpoint=xl|md|base (frames 53510:4824, 53510:4928, 53510:5021)
 */
import PageLayout from "@/layouts/PageLayout.astro";
import { Button } from "@/ui/button";
---

<PageLayout title="Page not found" noindex>
  <section class="flex flex-col items-start gap-12 px-container pt-hero pb-12">
    <h1 class="text-headline-xxl text-fg-primary">
      <span class="text-fg-tertiary">Page not found.</span> This page doesn't exist: it may have
      moved, or the link is wrong.
    </h1>
    <Button as="a" href="/" variant="secondary">
      Back to homepage
    </Button>
  </section>
</PageLayout>
