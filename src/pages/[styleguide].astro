---
/**
 * Styleguide — dev-only QA page. Lists every design token imported from Figma and every
 * component state. Values shown are computed live, so they reflect the current breakpoint
 * (resize the window) and theme (OS setting, or DevTools › Rendering › prefers-color-scheme).
 */
import Footer from "@/components/Footer.astro";
import GetInTouchModal from "@/components/GetInTouchModal.astro";
import Media from "@/components/Media.astro";
import RichText from "@/components/RichText.astro";
import ArticlePager from "@/components/ArticlePager.astro";
import ArticleToc from "@/components/ArticleToc.astro";
import NavItem from "@/components/NavItem.astro";
import BlogListCard from "@/components/BlogListCard.astro";
import WorkArchiveCard from "@/components/WorkArchiveCard.astro";
import WorkListCard from "@/components/WorkListCard.astro";
import AboutPrinciplesSection from "@/sections/AboutPrinciplesSection.astro";
import AboutWhySection from "@/sections/AboutWhySection.astro";
import CapabilitiesSection from "@/sections/CapabilitiesSection.astro";
import ClientsSection from "@/sections/ClientsSection.astro";
import FeaturedArticlesSection from "@/sections/FeaturedArticlesSection.astro";
import FeaturedWorkSection from "@/sections/FeaturedWorkSection.astro";
import HomeHeroSection from "@/sections/HomeHeroSection.astro";
import HowWeWorkSection from "@/sections/HowWeWorkSection.astro";
import JournalArchiveSection from "@/sections/JournalArchiveSection.astro";
import ProcessStepsSection from "@/sections/ProcessStepsSection.astro";
import ServiceOfferingSection from "@/sections/ServiceOfferingSection.astro";
import ServicesCtaSection from "@/sections/ServicesCtaSection.astro";
import ServicesOverviewSection from "@/sections/ServicesOverviewSection.astro";
import WorkFormatsSection from "@/sections/WorkFormatsSection.astro";
import WorkDetailsSection from "@/sections/WorkDetailsSection.astro";
import WorkArchiveSection from "@/sections/WorkArchiveSection.astro";
import type { MediaData } from "@/sanity/media";
import type {
  ALL_JOURNAL_QUERY_RESULT,
  FEATURED_WORK_QUERY_RESULT,
  SERVICE_DESCRIPTIONS_QUERY_RESULT,
  WORK_ARCHIVE_QUERY_RESULT,
} from "@/sanity/types";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/ui/button";
import { Badge } from "@/ui/badge";
import { Input } from "@/ui/input";
import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from "@/ui/accordion";
import { outline } from "@/lib/portableText";
import { OFFERINGS, SERVICES } from "@/lib/services";
import type { ServiceValue, Showreel } from "@/lib/showreels";

// Dynamic route with a single path in dev and none in production, so /styleguide
// is never emitted by `astro build`. Explicit pages always take priority over this route.
export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { styleguide: "styleguide" } }] : [];
}

const neutrals = ["50", "100", "200", "300", "400", "450", "500", "600", "700", "800", "900"];

// [css variable, Figma variable] — Figma Theme collection, colors/*
const semantic: Record<string, [string, string][]> = {
  Background: [
    ["bg-primary", "colors/background/color-bg-primary"],
    ["bg-secondary", "colors/background/color-bg-secondary"],
    ["bg-tertiary", "colors/background/color-bg-tertiary"],
    ["bg-elevated", "colors/background/color-bg-elevated"],
    ["bg-overlay", "colors/background/color-bg-overlay"],
    ["bg-translucent", "colors/background/color-bg-translucent"],
    ["bg-inverse", "custom (text selection fill, not in Figma)"],
  ],
  Foreground: [
    ["fg-primary", "colors/foreground/color-fg-primary"],
    ["fg-secondary", "colors/foreground/color-fg-secondary"],
    ["fg-tertiary", "colors/foreground/color-fg-tertiary"],
    ["fg-faded", "colors/foreground/color-fg-faded"],
    ["fg-link", "colors/foreground/color-fg-link"],
    ["fg-link-hover", "colors/foreground/color-fg-link-hover"],
    ["fg-link-active", "colors/foreground/color-fg-link-active"],
    ["fg-on-primary", "colors/foreground/color-fg-on-primary"],
    ["fg-on-secondary", "colors/foreground/color-fg-on-secondary"],
    ["fg-inverse", "colors/foreground/color-fg-inverse"],
  ],
  Interactive: [
    ["interactive-primary", "colors/interactive/color-interactive-primary"],
    ["interactive-primary-hover", "colors/interactive/color-interactive-primary-hover"],
    ["interactive-primary-active", "colors/interactive/color-interactive-primary-active"],
    ["interactive-secondary", "colors/interactive/color-interactive-secondary"],
    ["interactive-secondary-hover", "colors/interactive/color-interactive-secondary-hover"],
    ["interactive-secondary-active", "colors/interactive/color-interactive-secondary-active"],
    ["interactive-focus-ring", "colors/interactive/focus-ring"],
    ["interactive-focus-inner", "colors/interactive/focus-inner"],
  ],
  Border: [
    ["border-strong", "colors/border/color-border-strong"],
    ["border-medium", "colors/border/color-border-medium"],
    ["border-subtle", "colors/border/color-border-subtle"],
  ],
  "Media (code only)": [["bg-media-label", "Media play/pause button fill"]],
};

// [css variable, Figma variable, utility] — Figma Custom collection, layout/*
const layout: [string, string, string][] = [
  ["--grid-column-count", "layout/grid-column-count", "grid-cols-layout"],
  ["--grid-gutter", "layout/grid-gutter", "gap-gutter"],
  ["--container-max-width", "layout/container-max-width", "max-w-container"],
  ["--container-padding-x", "layout/container-padding-x", "px-container"],
  ["--section-padding-y", "layout/section-padding-y", "py-section, pt-section, pb-section"],
  ["--hero-padding-top", "layout/hero-padding-top", "pt-hero"],
];

// [utility, Figma text style, size var, line-height var]
const textStyles: [string, string, string, string][] = [
  [
    "text-headline-xxl",
    "Headline/Headline XXL",
    "--fontsize-headline-xxl",
    "--lineheight-headline-xxl",
  ],
  [
    "text-headline-xl",
    "Headline/Headline XL",
    "--fontsize-headline-xl",
    "--lineheight-headline-xl",
  ],
  [
    "text-headline-lg",
    "Headline/Headline LG",
    "--fontsize-headline-lg",
    "--lineheight-headline-lg",
  ],
  [
    "text-headline-md",
    "Headline/Headline MD",
    "--fontsize-headline-md",
    "--lineheight-headline-md",
  ],
  [
    "text-headline-sm",
    "Headline/Headline SM",
    "--fontsize-headline-sm",
    "--lineheight-headline-sm",
  ],
  [
    "text-headline-xs",
    "Headline/Headline XS",
    "--fontsize-headline-xs",
    "--lineheight-headline-xs",
  ],
  ["text-body-lg", "Body/Body LG Medium", "--fontsize-body-lg", "--lineheight-body-lg"],
  ["text-body-md", "Body/Body MD Medium", "--fontsize-body-md", "--lineheight-body-md"],
  ["text-body-sm", "Body/Body SM Medium", "--fontsize-body-sm", "--lineheight-body-sm"],
  ["text-body-xs", "Body/Body XS Medium", "--fontsize-body-xs", "--lineheight-body-xs"],
  ["text-label", "Labels/Label M Medium", "--fontsize-label-sm", "--lineheight-label-sm"],
  ["text-caption-md", "Caption/Caption M", "--fontsize-caption-m", "--lineheight-caption-m"],
  ["text-caption-sm", "Caption/Caption S", "--fontsize-caption-s", "--lineheight-caption-s"],
  ["text-eyebrow", "Eyebrow/Eyebrow", "--fontsize-eyebrow-md", "--lineheight-eyebrow-md"],
];

// Remaining text-style variables (families, weights, unused sizes)
const textVars = [
  "--headline-font-family",
  "--headline-font-weight",
  "--body-font-family",
  "--body-font-weight-medium",
  "--label-font-family",
  "--label-font-weight",
  "--fontsize-label-md",
  "--lineheight-label-md",
  "--caption-font-family",
  "--caption-font-weight",
  "--eyebrow-font-family",
  "--eyebrow-font-weight",
];

const motion: [string, string][] = [
  ["--motion-duration-enter", "section fade-in"],
  ["--motion-duration-exit", "old page fade-out (View Transition)"],
  ["--motion-stagger", "delay between sections / list items"],
  ["--motion-ease-enter", "entrance easing"],
  ["--motion-word-hold", "rotating headline word hold (home hero)"],
  ["--motion-duration-word", "rotating headline word roll in / out"],
  ["--motion-shift-word", "rotating headline word travel (share of its height)"],
];

// Media fixtures. The dataset has no assets yet, so images show the empty (bg-secondary) state.
// The video is a public HLS test stream, standing in for a Bunny playlist in this dev-only page.
const demoVideo = (playback: "ambient" | "player"): MediaData => ({
  kind: "video",
  video: {
    playlistUrl: "https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8",
    alt: "Demo video",
    caption: null,
    playback,
    poster: { _type: "image", lqip: null, dimensions: null },
  },
});

// A Bunny video without an uploaded poster: Media shows Bunny's own thumbnail (the dataset's
// first project video). The test stream above isn't on Bunny, so it shows bg-secondary instead.
const demoBunnyVideo: MediaData = {
  kind: "video",
  video: {
    playlistUrl:
      "https://vz-8d865576-a41.b-cdn.net/9df43d9e-0d5d-4475-bc36-4747500e69b0/playlist.m3u8",
    alt: "Demo Bunny video",
    caption: null,
    playback: "ambient",
    poster: null,
  },
};

// Code-defined showreels (home "Our services"): a Bunny playlist with its own thumbnail, the
// HLS test stream without a poster, and a service with no video yet (placeholder).
const demoShowreels: Record<ServiceValue, Showreel> = {
  brand: { playlistUrl: demoBunnyVideo.video?.playlistUrl ?? null },
  web: { playlistUrl: "https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8" },
  "digital-products": { playlistUrl: null },
};

// An image slot with no asset yet: renders the bg-secondary placeholder.
const emptyMedia: MediaData = { kind: "image", image: null, video: null };

// Work fixtures (Figma copy), for the cards.
const demoWork = {
  _id: "demo",
  title: "Modal",
  slug: "modal",
  services: ["brand", "web", "digital-products"],
  excerpt:
    "Developer-first platform changing the computing paradigm with a fully serverless cloud infrastructure for AI, ML, and data applications.",
};
const demoListWork: FEATURED_WORK_QUERY_RESULT[number] = {
  ...demoWork,
  summary: "Serverless cloud infrastructure for AI, ML and data teams.",
  client: "Modal",
  year: 2026,
  listingMedia: emptyMedia,
};
const demoListWorkVideo: FEATURED_WORK_QUERY_RESULT[number] = {
  ...demoListWork,
  _id: "demo-video",
  title: "Company AI",
  summary: "Explain what company does and how we helped",
  listingMedia: demoVideo("ambient"),
};
const demoArchiveWork: WORK_ARCHIVE_QUERY_RESULT[number] = {
  ...demoWork,
  archiveMedia: [emptyMedia, demoVideo("ambient"), emptyMedia],
};

// ServiceOfferingSection: accordion text per Brand capability (live copy is in Sanity).
const demoServiceDescriptions: SERVICE_DESCRIPTIONS_QUERY_RESULT = OFFERINGS.brand.capabilities.map(
  (title) => ({
    title,
    description: `What ${title.toLowerCase()} covers, in two or three sentences.`,
  }),
);

// Section fixtures: n copies with unique ids.
const listWorks = (n: number) =>
  Array.from({ length: n }, (_, i) => ({ ...demoListWork, _id: `list-${i}` }));
const archiveWorks = Array.from({ length: 3 }, (_, i) => ({
  ...demoArchiveWork,
  _id: `archive-${i}`,
  archiveMedia: [emptyMedia, emptyMedia, emptyMedia],
}));

// Journal fixtures (Figma copy).
const demoPost: ALL_JOURNAL_QUERY_RESULT[number] = {
  _id: "post",
  title: "Optimising a delivery process",
  slug: "optimising-a-delivery-process",
  publishedAt: "2025-08-17T09:00:00Z",
  category: "News",
  excerpt:
    "ML Developer Nico Lutz explains how routing algorithms expanded Norwegian delivery routes without schedule disruptions.",
  coverImage: null,
};
const posts = (n: number) =>
  Array.from({ length: n }, (_, i) => ({ ...demoPost, _id: `post-${i}` }));

// Work Single fixture (Figma copy).
const demoWorkDetails = {
  _id: "details",
  title: "Modal",
  slug: "modal",
  client: "Modal",
  year: 2026,
  services: ["brand", "web"],
  excerpt:
    "Developer-first platform changing the computing paradigm with a fully serverless cloud infrastructure for AI, ML, and data applications.",
  seo: null,
  industry: ["DevTools"],
  deliverables: ["Brand Strategy", "Brand System", "Website", "Product Design", "UX/UI Design"],
  challenge:
    "Etticus was building more than a product: it was defining a new layer of financial infrastructure.\n\nThe challenge was to translate that ambition into a system that could scale.",
  solution:
    "We created a scalable brand operating system that acts as an extension of the product.",
  outcome: "The result is a cohesive system where brand and product evolve together.",
  results: [
    { _key: "a", value: "20%", label: "Success metric" },
    { _key: "b", value: "3×", label: "Faster launches" },
    { _key: "c", value: "40+", label: "Components" },
  ],
  websiteUrl: "https://studiocoal.com",
  listingMedia: emptyMedia,
  heroMedia: emptyMedia,
  content: null,
} as unknown as Parameters<typeof WorkDetailsSection>[0]["work"];

// Clients fixture: the dataset has no logos, so the tiles render empty (asset refs are fake).
const demoClients = [
  "Vanta",
  "Coinbase",
  "Cabify",
  "Ebury",
  "Clara",
  "Unwrap",
  "Linear",
  "Stripe",
].map((name) => ({
  _key: name,
  name,
  logo: {
    _type: "image" as const,
    asset: { _ref: "image-demo-96x24-svg", _type: "reference" as const },
  },
}));

// Rich text fixture: every block style, a list, marks and a link.
const span = (text: string, marks: string[] = []) => ({
  _type: "span" as const,
  _key: text,
  text,
  marks,
});
const pt = (key: string, style: string, children: ReturnType<typeof span>[], extra = {}) => ({
  _type: "block" as const,
  _key: key,
  style,
  markDefs: [{ _key: "l1", _type: "link", href: "/work" }],
  children,
  ...extra,
});
const demoBody = [
  pt("p1", "normal", [
    span("As a studio, we have long worked in AI: building prototypes, developing "),
    span("products", ["strong"]),
    span(" and crafting "),
    span("product narratives", ["em"]),
    span(". See "),
    span("our work", ["l1"]),
    span("."),
  ]),
  pt("p2", "normal", [span("A second paragraph, one blank Body MD line below the first.")]),
  pt("h2", "h2", [span("Once Upon a Time in AI")]),
  pt("p3", "normal", [span("Paragraph after a heading.")]),
  pt("l1", "normal", [span("First bullet")], { listItem: "bullet", level: 1 }),
  pt("l2", "normal", [span("Second bullet")], { listItem: "bullet", level: 1 }),
  pt("h3", "h3", [span("A smaller heading")]),
  pt("q", "blockquote", [span("A pull quote from the panel discussion.")]),
  pt("h2b", "h2", [span("Panel")]),
  pt("n1", "normal", [span("First numbered step")], { listItem: "number", level: 1 }),
  pt("n2", "normal", [span("Second numbered step")], { listItem: "number", level: 1 }),
  pt("p4", "normal", [span("Closing paragraph.")]),
] as unknown as Parameters<typeof RichText>[0]["value"];
const demoOutline = outline(demoBody ?? []);

const radii = ["xs", "sm", "md", "lg", "xl", "2xl", "3xl", "4xl", "full"];
---

<BaseLayout title="Styleguide" noindex>
  <main class="flex flex-col gap-16 px-container py-section">
    <header class="flex flex-col gap-2">
      <p class="text-eyebrow text-fg-tertiary">STYLEGUIDE</p>
      <h1 class="text-headline-xxl">Studio Coal tokens & components</h1>
      <p class="max-w-2xl text-body-md text-fg-secondary">
        Every variable imported from Figma (Theme + Custom collections and the neutral palette),
        every text style and every component state. Values are computed live.
      </p>
      <p class="text-body-sm text-fg-tertiary">
        Breakpoint: <strong class="text-fg-primary" data-breakpoint></strong> · Theme:
        <strong class="text-fg-primary" data-theme></strong>
      </p>
    </header>

    <section class="flex flex-col gap-6">
      <h2 class="text-headline-lg">Neutral palette</h2>
      <p class="text-body-sm text-fg-secondary">
        Figma TailwindCSS › colors/neutral/*. Replaces Tailwind's neutral palette (
        <code>bg-neutral-500</code>…). Same in both themes.
      </p>
      <ul class="grid grid-cols-3 gap-4 md:grid-cols-6 xl:grid-cols-11">
        {neutrals.map((n) => (
          <li class="flex flex-col gap-2">
            <div
              class="h-16 rounded-sm border border-border-subtle"
              style={`background: var(--color-neutral-${n})`}
            />
            <span class="text-body-xs">neutral-{n}</span>
            <span class="text-caption-sm text-fg-tertiary" data-var={`--color-neutral-${n}`} />
          </li>
        ))}
      </ul>
    </section>

    <section class="flex flex-col gap-6">
      <h2 class="text-headline-lg">Semantic colors</h2>
      <p class="text-body-sm text-fg-secondary">
        Figma Theme › colors/*. Utilities: <code>bg-bg-primary</code>,{" "}
        <code>text-fg-secondary</code>,<code>border-border-subtle</code>,{" "}
        <code>bg-interactive-primary</code>…
      </p>
      {Object.entries(semantic).map(([group, tokens]) => (
        <div class="flex flex-col gap-3">
          <h3 class="text-headline-xs">{group}</h3>
          <ul class="grid grid-cols-2 gap-4 md:grid-cols-4 xl:grid-cols-6">
            {tokens.map(([name, figma]) => (
              <li class="flex flex-col gap-2">
                <div class="h-16 rounded-sm border border-border-subtle bg-[repeating-conic-gradient(var(--bg-tertiary)_0_25%,transparent_0_50%)] bg-size-[16px_16px]">
                  {/* checkerboard shows transparency; arbitrary values allowed: dev-only page */}
                  <div class="size-full rounded-sm" style={`background: var(--${name})`} />
                </div>
                <span class="text-body-xs">{name}</span>
                <span class="text-caption-sm text-fg-tertiary">{figma.split("/").pop()}</span>
                <span class="text-caption-sm text-fg-tertiary" data-var={`--${name}`} />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="flex flex-col gap-6">
      <h2 class="text-headline-lg">Layout</h2>
      <p class="text-body-sm text-fg-secondary">Figma Custom › layout/*. Switches at md and xl.</p>
      <table class="w-full text-left text-body-sm">
        <thead class="text-caption-md text-fg-tertiary">
          <tr>
            <th class="py-2">Variable</th>
            <th>Figma</th>
            <th>Utility</th>
            <th>Now</th>
          </tr>
        </thead>
        <tbody>
          {layout.map(([v, figma, util]) => (
            <tr class="border-t border-border-subtle">
              <td class="py-2">
                <code>{v}</code>
              </td>
              <td class="text-fg-secondary">{figma}</td>
              <td>
                <code>{util}</code>
              </td>
              <td data-var={v} />
            </tr>
          ))}
        </tbody>
      </table>
      <div class="grid-cols-layout">
        {Array.from({ length: 12 }, () => (
          <div class="h-12 bg-bg-secondary" />
        ))}
      </div>
    </section>

    <section class="flex flex-col gap-6">
      <h2 class="text-headline-lg">Text styles</h2>
      <p class="text-body-sm text-fg-secondary">
        Figma text styles → utilities. Size and line height come from the Custom › text styles/*
        variables and switch at md and xl.
      </p>
      <ul class="flex flex-col">
        {textStyles.map(([util, figma, size, lh]) => (
          <li class="grid gap-2 border-t border-border-subtle py-4 xl:grid-cols-[16rem_1fr]">
            {/* fixed label column: dev-only page */}
            <div class="flex flex-col gap-1">
              <code class="text-body-xs">{util}</code>
              <span class="text-caption-sm text-fg-tertiary">{figma}</span>
              <span class="text-caption-sm text-fg-tertiary">
                <span data-var={size} /> / <span data-var={lh} /> · {size}
              </span>
            </div>
            <span class={util}>Brands built with purpose and precision</span>
          </li>
        ))}
      </ul>
      <h3 class="text-headline-xs">Other text-style variables</h3>
      <table class="w-full text-left text-body-sm">
        <tbody>
          {textVars.map((v) => (
            <tr class="border-t border-border-subtle">
              <td class="py-2">
                <code>{v}</code>
              </td>
              <td data-var={v} />
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="flex flex-col gap-6">
      <h2 class="text-headline-lg">Radius</h2>
      <p class="text-body-sm text-fg-secondary">
        Figma Theme › radius/* equals Tailwind's default scale: use <code>rounded-*</code>.
      </p>
      <ul class="flex flex-wrap gap-4">
        {radii.map((r) => (
          <li class="flex flex-col items-center gap-2">
            <div class={`size-16 border border-border-medium bg-bg-secondary rounded-${r}`} />
            <span class="text-body-xs">rounded-{r}</span>
            <span class="text-caption-sm text-fg-tertiary" data-var={`--radius-${r}`} />
          </li>
        ))}
      </ul>
    </section>

    <section class="flex flex-col gap-6">
      <h2 class="text-headline-lg">Motion</h2>
      <p class="max-w-2xl text-body-sm text-fg-secondary">
        Page transitions (src/styles/motion.css). After an in-site navigation, children of{" "}
        <code>animate-enter-stagger</code> fade in one after another; <code>animate-enter</code>{" "}
        does the same for one element. The nav pill gets <code>view-transition-header</code> and the
        Get in touch button <code>view-transition-header-action</code>, so both stay pinned. Off
        under reduced motion.
      </p>
      <ul class="flex flex-col gap-2">
        {motion.map(([name, use]) => (
          <li class="flex flex-wrap gap-x-4 text-body-xs">
            <code>{name}</code>
            <span class="text-fg-tertiary" data-var={name} />
            <span class="text-fg-secondary">{use}</span>
          </li>
        ))}
      </ul>
      <div class="flex flex-wrap gap-4">
        <Button type="button" data-replay-entrance>
          Replay entrance
        </Button>
        <Button as="a" href="/" variant="secondary">
          Navigate to home (View Transition)
        </Button>
      </div>
      <div data-entrance-demo>
        <ul class="grid animate-enter-stagger grid-cols-2 gap-gutter md:grid-cols-3 xl:grid-cols-6">
          {[1, 2, 3, 4, 5, 6].map((n) => (
            <li class="flex aspect-4/5 items-end rounded-sm bg-bg-secondary p-4 text-label">{n}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="flex flex-col gap-6">
      <h2 class="text-headline-lg">Navbar / NavItem</h2>
      <p class="max-w-2xl text-body-sm text-fg-secondary">
        Figma "Navbar / NavItem" (node 704:3403). The Navbar itself (node 5005:6313) renders on
        every page through PageLayout: see{" "}
        <a href="/" class="underline">
          the home page
        </a>{" "}
        at 375 / 768 / 1440.
      </p>
      <p class="max-w-2xl text-body-sm text-fg-secondary">
        Nav items are text only. One shared pill (bg interactive-secondary-active, rounded-xs) sits
        under the current page and slides to the hovered, focused or pressed item: hover the live
        navbar above to see it. Text colours change only after navigating.
      </p>
      <ul class="flex flex-wrap items-end gap-6">
        <li class="flex flex-col gap-2">
          <NavItem href="#">Menu Item</NavItem>
          <span class="text-caption-sm text-fg-tertiary">Default</span>
        </li>
