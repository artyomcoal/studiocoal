<script>
  // Dev-only: print computed token values and the active breakpoint / theme.
  function update() {
    const root = getComputedStyle(document.documentElement);
    document.querySelectorAll<HTMLElement>("[data-var]").forEach((el) => {
      const name = el.dataset.var!;
      let value = root.getPropertyValue(name).trim();
      const probe = document.createElement("div");
      probe.style.position = "absolute";
      document.body.append(probe);
      if (/color|bg-|fg-|border-|interactive-/.test(name)) {
        probe.style.color = `var(${name})`;
        const c = getComputedStyle(probe).color;
        const m = c.match(/color\(srgb ([\d.]+) ([\d.]+) ([\d.]+)(?: \/ ([\d.]+))?\)/);
        value = m
          ? `rgba(${[m[1], m[2], m[3]].map((x) => Math.round(+x * 255)).join(", ")}, ${m[4] ?? 1})`
          : c;
      } else if (/rem|calc/.test(value)) {
        probe.style.width = `var(${name})`;
        value = `${parseFloat(getComputedStyle(probe).width)}px`;
      }
      probe.remove();
      el.textContent = value || "—";
    });
    const w = window.innerWidth;
    document.querySelector("[data-breakpoint]")!.textContent =
      w >= 1024 ? `xl (${w}px)` : w >= 768 ? `md (${w}px)` : `base (${w}px)`;
    document.querySelector("[data-theme]")!.textContent = matchMedia(
      "(prefers-color-scheme: light)",
    ).matches
      ? "light"
      : "dark";
  }
  update();
  addEventListener("resize", update);

  // Motion demo: toggle the trigger class on the demo wrapper only, so the page itself stays.
  const demo = document.querySelector<HTMLElement>("[data-entrance-demo]")!;
  document.querySelector("[data-replay-entrance]")!.addEventListener("click", () => {
    demo.classList.remove("nav-entered");
    void demo.offsetWidth; // restart the animations
    demo.classList.add("nav-entered");
  });
  matchMedia("(prefers-color-scheme: light)").addEventListener("change", update);
</script>
