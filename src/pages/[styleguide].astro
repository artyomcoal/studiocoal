---
/**
 * Styleguide — dev-only QA page. Lists every token and component state.
 * Not available in production builds.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/ui/button";
import { Badge } from "@/ui/badge";
import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from "@/ui/accordion";

// Dynamic route with a single path in dev and none in production, so /styleguide
// is never emitted by `astro build`. Explicit pages always take priority over this route.
export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { styleguide: "styleguide" } }] : [];
}

const colors = [
  ["bg-primary", "bg-bg-primary"],
  ["bg-secondary", "bg-bg-secondary"],
  ["bg-tertiary", "bg-bg-tertiary"],
  ["bg-translucent", "bg-bg-translucent"],
  ["fg-primary", "bg-fg-primary"],
  ["fg-secondary", "bg-fg-secondary"],
  ["fg-tertiary", "bg-fg-tertiary"],
  ["fg-faded", "bg-fg-faded"],
  ["fg-on-primary", "bg-fg-on-primary"],
  ["fg-on-secondary", "bg-fg-on-secondary"],
  ["border-subtle", "bg-border-subtle"],
  ["interactive-primary", "bg-interactive-primary"],
  ["interactive-primary-hover", "bg-interactive-primary-hover"],
  ["interactive-primary-active", "bg-interactive-primary-active"],
  ["interactive-secondary", "bg-interactive-secondary"],
  ["interactive-secondary-hover", "bg-interactive-secondary-hover"],
  ["interactive-focus-ring", "bg-interactive-focus-ring"],
];

const type = [
  ["text-headline-xxl", "text-headline-xxl"],
  ["text-headline-xl", "text-headline-xl"],
  ["text-headline-lg", "text-headline-lg"],
  ["text-headline-md", "text-headline-md"],
  ["text-headline-sm", "text-headline-sm"],
  ["text-headline-xs", "text-headline-xs"],
  ["text-body-lg", "text-body-lg"],
  ["text-body-md", "text-body-md"],
  ["text-body-sm", "text-body-sm"],
  ["text-body-xs", "text-body-xs"],
  ["text-label", "text-label"],
  ["text-caption-md", "text-caption-md"],
  ["text-caption-sm", "text-caption-sm"],
  ["text-eyebrow", "text-eyebrow"],
];
---

<BaseLayout title="Styleguide — Studio Coal">
  <main class="px-container py-section flex flex-col gap-12">
    <header class="flex flex-col gap-2">
      <p class="text-eyebrow text-fg-tertiary">STYLEGUIDE</p>
      <h1 class="text-headline-xxl">Tokens</h1>
      <p class="text-body-md text-fg-secondary">
        Dev-only page for visual QA against Figma. Resize to check base, md (768) and xl (1024).
      </p>
    </header>

    <section class="flex flex-col gap-4">
      <h2 class="text-headline-lg">Colors</h2>
      <ul class="grid grid-cols-2 gap-4 md:grid-cols-4 xl:grid-cols-6">
        {
          colors.map(([name, cls]) => (
            <li class="flex flex-col gap-2">
              <div class={`h-16 rounded-sm border border-border-subtle ${cls}`} />
              <span class="text-body-xs text-fg-secondary">{name}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="flex flex-col gap-4">
      <h2 class="text-headline-lg">Typography</h2>
      <ul class="flex flex-col gap-4">
        {
          type.map(([name, cls]) => (
            <li class="flex flex-col gap-1 border-b border-border-subtle pb-4">
              <span class="text-caption-md text-fg-tertiary">{name}</span>
              <span class={cls}>Brands built with purpose and precision</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="flex flex-col gap-4">
      <h2 class="text-headline-lg">Layout</h2>
      <p class="text-body-sm text-fg-secondary">
        px-container, py-section, pt-hero, gap-gutter and grid-cols-layout switch at md and xl.
        The 12-column grid below uses grid-cols-layout.
      </p>
      <div class="grid-cols-layout">
        {Array.from({ length: 12 }, (_, i) => <div class="h-12 bg-bg-secondary" data-col={i + 1} />)}
      </div>
    </section>

    <section class="flex flex-col gap-6">
      <h2 class="text-headline-lg">Button</h2>
      <p class="text-body-sm text-fg-secondary">
        Hover, press and Tab to check states. Focus = hover fill + 2px gap + 2px focus ring.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <Button>Primary</Button>
        <Button variant="secondary">Secondary</Button>
        <Button as="a" href="#">Link as button</Button>
        <Button disabled>Disabled</Button>
        <Button variant="secondary" disabled>Disabled</Button>
      </div>
    </section>

    <section class="flex flex-col gap-6">
      <h2 class="text-headline-lg">Badge</h2>
      <div class="flex flex-wrap items-center gap-2">
        <Badge>Small secondary</Badge>
        <Badge variant="tertiary">Small tertiary</Badge>
        <Badge size="default">Default secondary</Badge>
        <Badge variant="tertiary" size="default">Default tertiary</Badge>
      </div>
    </section>

    <section class="flex flex-col gap-6">
      <h2 class="text-headline-lg">Accordion</h2>
      <div class="grid gap-12 md:grid-cols-2">
        <div class="flex flex-col gap-2">
          <p class="text-caption-md text-fg-tertiary">size="xs" (Services, Work Single)</p>
          <Accordion>
            <AccordionItem value="brand">
              <AccordionTrigger>Brand strategy</AccordionTrigger>
              <AccordionContent>
                Positioning, naming and messaging that give your company a clear voice.
              </AccordionContent>
            </AccordionItem>
            <AccordionItem value="identity">
              <AccordionTrigger>Visual identity</AccordionTrigger>
              <AccordionContent>Logo, type, colour and a system that scales.</AccordionContent>
            </AccordionItem>
            <AccordionItem value="guidelines">
              <AccordionTrigger>Brand guidelines</AccordionTrigger>
              <AccordionContent>Rules and examples your team can use without us.</AccordionContent>
            </AccordionItem>
          </Accordion>
        </div>
        <div class="flex flex-col gap-2">
          <p class="text-caption-md text-fg-tertiary">size="md" (About)</p>
          <Accordion defaultValue="craft">
            <AccordionItem value="craft">
              <AccordionTrigger size="md">Craft over volume</AccordionTrigger>
              <AccordionContent>We take on few projects so each one gets senior attention.</AccordionContent>
            </AccordionItem>
            <AccordionItem value="partners">
              <AccordionTrigger size="md">Partners, not vendors</AccordionTrigger>
              <AccordionContent>We work inside your team, in your tools.</AccordionContent>
            </AccordionItem>
          </Accordion>
        </div>
      </div>
    </section>

    <section class="flex flex-col gap-6">
      <h2 class="text-headline-lg">Divider</h2>
      <p class="text-body-sm text-fg-secondary">
        No component: horizontal is <code>&lt;hr class="border-border-subtle"&gt;</code>; vertical is
        <code>&lt;div role="separator" aria-orientation="vertical" class="w-px self-stretch bg-border-subtle"&gt;</code>.
      </p>
      <hr class="border-border-subtle" />
      <div class="flex h-16 items-center gap-4 text-body-sm">
        <span>Left</span>
        <div role="separator" aria-orientation="vertical" class="w-px self-stretch bg-border-subtle"></div>
        <span>Right</span>
      </div>
    </section>
  </main>
</BaseLayout>
