---
import { cva } from "class-variance-authority";
import { cn } from "@/lib/utils";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  class?: string;
  /** Radix-like: render wrapper so the child can be the interactive element */
  asChild?: boolean;
  /**
   * Trigger text style. Figma uses Headline XS (Services, Work Single) and
   * Headline MD (About: 18px base/md, 20px xl). body is the compact Body MD row with 16px vertical
   * padding (Process › Work formats sidebar).
   */
  size?: "body" | "xs" | "md";
  /**
   * What the accordion sits on: the page (default) or a filled bg-secondary panel (filled). On a
   * filled panel the icon box uses the interactive-secondary palette one step darker.
   */
  surface?: "default" | "filled";
}

const {
  class: className = "",
  asChild = false,
  size = "xs",
  surface = "default",
  type = "button",
  ...rest
} = Astro.props as Props;

// Studio Coal: restyled to Figma "AccordionItem" (node 672:1702). Changes from upstream:
// - text from headline styles via `size`, interactive-primary color, hover/expanded/focus use -hover
// - 20px vertical padding (py-5; 16px for size body), Figma focus ring, plus icon in a 24px box instead of chevrons.
//   Box fill (owner, 2026-11-06): interactive-secondary at rest, -hover on hover / keyboard focus,
//   -active on press and while the item is open. `surface="filled"` (accordions on a bg-secondary
//   panel) shifts that one step darker: -hover at rest, -active on hover and while open.
// - the plus morphs to a minus when open: its vertical bar (own SVG, stacked in the same grid
//   cell) rotates 90° onto the horizontal one (--motion-*-accordion, off under reduced motion)
// - cursor-pointer: Tailwind v4 Preflight leaves <button> on the default cursor
// Icon box: rest → hover (also keyboard focus) → active, and active stays while the item is open.
// On a filled panel everything is one step darker, so the box still stands out from the panel.
const iconVariants = cva(
  [
    "pointer-events-none grid size-6 shrink-0 place-items-center rounded-xs text-fg-primary transition-colors *:col-start-1 *:row-start-1",
  ],
  {
    variants: {
      surface: {
        default: [
          "bg-interactive-secondary",
          "group-hover/accordion-trigger:bg-interactive-secondary-hover group-focus-visible/accordion-trigger:bg-interactive-secondary-hover",
          "group-active/accordion-trigger:bg-interactive-secondary-active group-aria-expanded/accordion-trigger:bg-interactive-secondary-active",
        ],
        filled: [
          "bg-interactive-secondary-hover",
          "group-hover/accordion-trigger:bg-interactive-secondary-active group-focus-visible/accordion-trigger:bg-interactive-secondary-active",
          "group-active/accordion-trigger:bg-interactive-secondary-active group-aria-expanded/accordion-trigger:bg-interactive-secondary-active",
        ],
      },
    },
    defaultVariants: { surface: "default" },
  },
);

const triggerVariants = cva(
  [
    "group/accordion-trigger relative flex flex-1 cursor-pointer items-center justify-between gap-4 text-left",
    "text-interactive-primary transition-colors duration-150 ease-out outline-none",
    "hover:text-interactive-primary-hover aria-expanded:text-interactive-primary-hover focus-visible:text-interactive-primary-hover",
    "focus-visible:ring-2 focus-visible:ring-interactive-focus-ring focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary",
    "aria-disabled:pointer-events-none aria-disabled:opacity-50",
  ],
  {
    variants: {
      size: {
        body: "py-4 text-body-md",
        xs: "py-5 text-headline-xs",
        md: "py-5 text-headline-md",
      },
    },
    defaultVariants: { size: "xs" },
  },
);
---

{asChild ? (
  <div class="flex">
    <div
      data-slot="accordion-trigger"
      data-as-child
      class={cn(triggerVariants({ size }), className)}
    >
      <slot />
    </div>
  </div>
) : (
  <div class="flex">
    <button
      {...rest}
      type={type}
      data-slot="accordion-trigger"
      class={cn(triggerVariants({ size }), className)}
    >
      <slot />
      {Astro.slots.has("icon") ? (
        <span data-slot="accordion-trigger-icon" class="pointer-events-none shrink-0">
          <slot name="icon" />
        </span>
      ) : (
        <span
          data-slot="accordion-trigger-icon"
          aria-hidden="true"
          class={iconVariants({ surface })}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
          >
            <path d="M8 12H16" stroke="currentColor" stroke-width="1.25" />
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            class="transition-transform duration-(--motion-duration-accordion) ease-(--motion-ease-accordion) group-aria-expanded/accordion-trigger:rotate-90 motion-reduce:transition-none"
          >
            <path d="M12 8V16" stroke="currentColor" stroke-width="1.25" />
          </svg>
        </span>
      )}
    </button>
  </div>
)}
