---
/**
 * @component Button
 * @description Figma "Button" (node 444:177). variant: primary | secondary | tertiary, size: default | sm | icon. Render a link with as="a".
 * @usage
 * <Button>Get in touch</Button>
 * <Button variant="secondary" as="a" href="/work">View work</Button>
 */

import type { HTMLAttributes } from "astro/types";
import { cva, type VariantProps } from "class-variance-authority";

import { cn } from "@/lib/utils";

// Studio Coal: restyled to Figma "Button" (node 444:177). Changes from upstream:
// - variants reduced to primary | secondary (Figma Type), one size (h-10, px-5, py-3)
// - colors from interactive-* tokens, text-label type style, rounded-sm
// - focus ring per Figma FocusState: 2px bg-primary gap + 2px focus-ring, hover fill on focus
// - variant tertiary: the Secondary button on an interactive-secondary surface (Get in touch
//   dialog), resting on the secondary hover fill as in Figma (node 5588:8842)
// - sizes sm (Copy: h-7, px-3, rounded-xs) and icon (Close: size-6, rounded-xs)
const buttonVariants = cva(
  [
    "group/button inline-flex shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-sm text-label select-none",
    "transition-colors duration-150 ease-out outline-none",
    "focus-visible:ring-2 focus-visible:ring-interactive-focus-ring focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary",
    "disabled:pointer-events-none disabled:opacity-50 aria-disabled:pointer-events-none aria-disabled:opacity-50",
    "[&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4",
  ],
  {
    variants: {
      variant: {
        primary:
          "bg-interactive-primary text-fg-on-primary hover:bg-interactive-primary-hover focus-visible:bg-interactive-primary-hover active:bg-interactive-primary-active",
        secondary:
          "bg-interactive-secondary text-fg-on-secondary hover:bg-interactive-secondary-hover focus-visible:bg-interactive-secondary-hover active:bg-interactive-secondary-active",
        tertiary:
          "bg-interactive-secondary-hover text-fg-on-secondary hover:bg-interactive-secondary-active focus-visible:bg-interactive-secondary-active active:bg-interactive-secondary-active",
      },
      size: {
        default: "h-10 px-5 py-3",
        sm: "h-7 rounded-xs px-3 py-2",
        icon: "size-6 rounded-xs",
      },
    },
    defaultVariants: {
      variant: "primary",
      size: "default",
    },
  },
);

type ButtonVariantProps = VariantProps<typeof buttonVariants>;

type ButtonAsButton = {
  as?: "button";
} & HTMLAttributes<"button">;

type ButtonAsAnchor = {
  as: "a";
} & HTMLAttributes<"a">;

type ButtonOwnProps = ButtonVariantProps & {
  // you can add custom props here
};

export type Props = (ButtonAsButton | ButtonAsAnchor) & ButtonOwnProps;

const {
  as: Tag = "button",
  variant = "primary",
  size = "default",
  class: className = "",
  ...rest
} = Astro.props as Props;
---

{/*
  TS can't reconcile our discriminated union props with a dynamic intrinsic Tag.
  The public Props type *is* strict (href only allowed when as="a"),
  but JSX wants an intersection of button+anchor attributes here.
  We deliberately suppress this internal error and rely on Props for caller safety.
*/}
<!-- @ts-expect-error – union Props + dynamic Tag confuse JSX typing (see comment above) -->
<Tag
  data-slot="button"
  data-variant={variant}
  data-size={size}
  class={cn(buttonVariants({ variant, size }), className)}
  {...rest}
>
  <slot />
</Tag>
