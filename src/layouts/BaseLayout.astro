---
/**
 * Base layout: document shell, fonts and SEO / social meta.
 * A fixed page passes `page`: its texts come from its Studio document (Pages › …), then from
 * its built-in texts (src/lib/pages.ts). Site-wide defaults come from the Sanity siteSettings
 * singleton, then from src/lib/seo.ts.
 */
import { sanityClient } from "sanity:client";
import { iconPath, ICONS } from "@/lib/icons";
import { pageDocumentId, pageInfo, type PageKey } from "@/lib/pages";
import { buildSeo, canonicalUrl, contentSeo, SITE_NAME } from "@/lib/seo";
import {
  breadcrumbs,
  graph,
  organization,
  serializeJsonLd,
  webPage,
  website,
} from "@/lib/structured-data";
import { urlFor } from "@/sanity/image";
import { PAGE_QUERY, SITE_SETTINGS_QUERY } from "@/sanity/queries";
import "@/styles/globals.css";
// Dev only: the dev server doesn't embed Graphik in the CSS (Vite inlines assets at build
// time), so preload the file there, or the navbar shows the fallback font on every navigation.
import graphikDevUrl from "@/assets/fonts/Graphik_Medium.woff2?url";

interface Props {
  /**
   * One of the fixed pages (src/lib/pages.ts): title, description, share image and "hide from
   * search engines" then come from its Studio document, and the page gets its own structured
   * data. The props below override it where set.
   */
  page?: PageKey;
  /** Page title without the site name. Omit on the home page. */
  title?: string;
  description?: string | null;
  /** Absolute URL of a 1200 × 630 social image. Defaults to the site settings image. */
  image?: string | null;
  /** Ask search engines not to list the page (SEO › Hide from search engines). */
  noindex?: boolean;
  /** Open Graph type: "article" for Journal posts. */
  ogType?: "website" | "article";
  /**
   * Page-specific structured data nodes (src/lib/structured-data.ts). The organisation and
   * website nodes are added on every page, so page nodes can reference them.
   */
  jsonLd?: Record<string, unknown>[];
}

const { page, title, description, image, noindex, ogType = "website", jsonLd = [] } = Astro.props;

const info = page ? pageInfo(page) : null;
const [settings, pageSettings] = await Promise.all([
  sanityClient.fetch(SITE_SETTINGS_QUERY),
  page ? sanityClient.fetch(PAGE_QUERY, { id: pageDocumentId(page) }) : null,
]);
const shareImage = (source?: NonNullable<typeof settings>["seo"] | null) =>
  source?.image?.asset ? urlFor(source.image).width(1200).height(630).fit("crop").url() : null;
// The page's Studio fields first, then its built-in texts.
const pageSeo = info
  ? contentSeo({ title: info.title, excerpt: info.description, seo: pageSettings?.seo })
  : null;

const seo = buildSeo({
  title: title ?? pageSeo?.title,
  description:
    description ?? pageSeo?.description ?? settings?.seo?.description ?? settings?.description,
  image: image ?? shareImage(pageSettings?.seo) ?? shareImage(settings?.seo),
  pathname: Astro.url.pathname,
  site: Astro.site ?? Astro.url.origin,
  noindex: noindex ?? pageSeo?.noindex,
});

const site = String(Astro.site ?? Astro.url.origin);
// Site settings › Icon: PNGs built by src/pages/icons/[file].ts. Without it, /favicon.svg.
const hasIcon = !!settings?.favicon?.asset;
// Fixed pages describe themselves; project and post pages pass their own nodes (jsonLd).
const pageNodes = info
  ? [
      webPage({
        site,
        url: seo.canonical,
        type:
          info.key === "about"
            ? "AboutPage"
            : info.key === "work" || info.key === "journal"
              ? "CollectionPage"
              : "WebPage",
        name: seo.title,
        description: seo.description,
        summary: pageSettings?.aiSummary,
      }),
      ...(info.path === "/"
        ? []
        : [
            breadcrumbs([
              ["Home", new URL("/", site).href],
              [info.name, canonicalUrl(info.path, site)],
            ]),
          ]),
    ]
  : [];
const structuredData = serializeJsonLd(
  graph(
    organization({
      site,
      description: settings?.description,
      email: settings?.email,
      sameAs: settings?.social?.map((link) => link.href),
      logo: hasIcon ? new URL(iconPath("icon-512.png"), site).href : null,
      address: settings?.address,
    }),
    website(site),
    ...pageNodes,
    ...(jsonLd as Parameters<typeof graph>),
  ),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Both themes, dark first (as in tokens.css). Declared here, before any stylesheet, so the
         browser's own canvas is already dark (or light, per the OS) on a page's first frame and
         during page transitions. Without it the canvas defaulted to white until the stylesheet
         applied, and a transition sometimes flashed a blank white page. -->
    <meta name="color-scheme" content="dark light" />
    <!-- Cross-document View Transition opt-in (src/styles/motion.css). Inline and first on
         purpose: Chrome reads the opt-in as soon as the new page may render, and from the
         external stylesheet it often wasn't applied yet, so the transition was skipped. -->
    <style is:inline>
      @view-transition {
        navigation: auto;
      }
      @media (prefers-reduced-motion: reduce) {
        @view-transition {
          navigation: none;
        }
      }
    </style>
    <!-- Hold the new page's first frame until the navbar is parsed, so the transition always
         captures it. Without this, a slow response (the dev server) showed the page before the
         body arrived: the navbar wasn't in the snapshot, so it vanished and popped back in.
         Chromium only; others ignore it. Pages without a navbar unblock at the end of parsing. -->
    <link rel="expect" href="#site-header" blocking="render" />
    {hasIcon ? (
      ICONS.filter((icon) => icon.rel).map((icon) => (
        <link
          rel={icon.rel}
          type="image/png"
          sizes={`${icon.size}x${icon.size}`}
          href={iconPath(icon.file)}
        />
      ))
    ) : (
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    )}
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <!-- Graphik is embedded in the stylesheet in builds (src/styles/typography.css), so it needs no
         preload there; the dev server serves it as a file, so preload it in dev. Geist Mono is
         self-hosted (public/fonts/) and used above the fold: preload it. -->
    {import.meta.env.DEV && (
      <link rel="preload" href={graphikDevUrl} as="font" type="font/woff2" crossorigin />
    )}
    <link
      rel="preload"
      href="/fonts/geist/GeistMono-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Entrance animation (src/styles/motion.css), only after an in-site navigation: direct
         visits, reloads and reduced motion stay static, so LCP isn't delayed. Runs before first
         paint. `nav-entered` hides the sections; `nav-ready` fades them in once
         1. the page transition (if any) has finished, so the old page's fade-out and the new
            page's fade-in never overlap, and
         2. the fonts and the images on screen are decoded, so nothing pops in mid-fade.
         A 1s cap keeps a slow image from holding the page back. -->
    <script is:inline>
      try {
        const root = document.documentElement;
        const nav = performance.getEntriesByType("navigation")[0];
        if (
          nav?.type !== "reload" &&
          !matchMedia("(prefers-reduced-motion: reduce)").matches &&
          document.referrer &&
          new URL(document.referrer).origin === location.origin
        ) {
          root.classList.add("nav-entered");
          const transitionDone = new Promise((resolve) => {
            if (!("onpagereveal" in window)) return resolve();
            addEventListener(
              "pagereveal",
              (event) =>
                event.viewTransition
                  ? event.viewTransition.finished.then(resolve, resolve)
                  : resolve(),
              { once: true },
            );
          });
          const pageReady = new Promise((resolve) => {
            addEventListener(
              "DOMContentLoaded",
              () => {
                const onScreen = [...document.querySelectorAll("main img")].filter(
                  (img) => img.getBoundingClientRect().top < innerHeight,
                );
                Promise.all([
                  document.fonts.ready,
                  ...onScreen.map((img) => img.decode().catch(() => {})),
                ]).then(resolve);
              },
              { once: true },
            );
          });
          const cap = new Promise((resolve) => setTimeout(resolve, 1000));
          Promise.race([Promise.all([transitionDone, pageReady]), cap]).then(() =>
            root.classList.add("nav-ready"),
          );
        }
      } catch {
        /* Malformed referrer: no entrance. */
      }
    </script>
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {seo.noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {settings?.googleSiteVerification && (
      <meta name="google-site-verification" content={settings.googleSiteVerification.trim()} />
    )}
    {settings?.bingSiteVerification && (
      <meta name="msvalidate.01" content={settings.bingSiteVerification.trim()} />
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    {seo.image && (
      <>
        <meta property="og:image" content={seo.image} />
        <!-- Every share image is cropped or rendered to 1200 × 630. -->
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta name="twitter:card" content={seo.image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    {seo.image && <meta name="twitter:image" content={seo.image} />}
    <script type="application/ld+json" set:html={structuredData} />
    <!-- Page-specific head tags, e.g. the LCP image preload on project pages. -->
    <slot name="head" />
  </head>
  <body>
    <!-- Start decoding Graphik as soon as the stylesheet is ready (this runs right after it).
         Otherwise Chromium only starts when it first lays out text, so a page's first frame
         could still be drawn in the fallback font. -->
    <script is:inline>
      document.fonts.load("500 1em Graphik");
    </script>
    <slot />
  </body>
</html>
