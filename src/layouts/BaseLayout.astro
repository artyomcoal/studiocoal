---
/**
 * Base layout: document shell, fonts and SEO / social meta.
 * A fixed page passes `page`: its texts come from its Studio document (Pages › …), then from
 * its built-in texts (src/lib/pages.ts). Site-wide defaults come from the Sanity siteSettings
 * singleton, then from src/lib/seo.ts.
 */
import { sanityClient } from "sanity:client";
import { iconPath, ICONS } from "@/lib/icons";
import { pageDocumentId, pageInfo, type PageKey } from "@/lib/pages";
import { buildSeo, canonicalUrl, contentSeo, SITE_NAME } from "@/lib/seo";
import {
  breadcrumbs,
  graph,
  organization,
  serializeJsonLd,
  webPage,
  website,
} from "@/lib/structured-data";
import { urlFor } from "@/sanity/image";
import { PAGE_QUERY, SITE_SETTINGS_QUERY } from "@/sanity/queries";
import "@/styles/globals.css";
// Dev only: the dev server doesn't embed Graphik in the CSS (Vite inlines assets at build
// time), so preload the file there, or the navbar shows the fallback font on every navigation.
import graphikDevUrl from "@/assets/fonts/Graphik_Medium.woff2?url";

interface Props {
  /**
   * One of the fixed pages (src/lib/pages.ts): title, description, share image and "hide from
   * search engines" then come from its Studio document, and the page gets its own structured
   * data. The props below override it where set.
   */
  page?: PageKey;
  /** Page title without the site name. Omit on the home page. */
  title?: string;
  description?: string | null;
  /** Absolute URL of a 1200 × 630 social image. Defaults to the site settings image. */
  image?: string | null;
  /** Ask search engines not to list the page (SEO › Hide from search engines). */
  noindex?: boolean;
  /**
   * false: no canonical link or og:url. For the 404 page, which answers every unknown path, so
   * its own URL (/404) isn't a real page to point search engines or shares at.
   */
  canonical?: false;
  /** Open Graph type: "article" for Journal posts. */
  ogType?: "website" | "article";
  /**
   * Page-specific structured data nodes (src/lib/structured-data.ts). The organisation and
   * website nodes are added on every page, so page nodes can reference them.
   */
  jsonLd?: Record<string, unknown>[];
}

const {
  page,
  title,
  description,
  image,
  noindex,
  canonical = true,
  ogType = "website",
  jsonLd = [],
} = Astro.props;

const info = page ? pageInfo(page) : null;
const [settings, pageSettings] = await Promise.all([
  sanityClient.fetch(SITE_SETTINGS_QUERY),
  page ? sanityClient.fetch(PAGE_QUERY, { id: pageDocumentId(page) }) : null,
]);
const shareImage = (source?: NonNullable<typeof settings>["seo"] | null) =>
  source?.image?.asset ? urlFor(source.image).width(1200).height(630).fit("crop").url() : null;
// The page's Studio fields first, then its built-in texts.
const pageSeo = info
  ? contentSeo({ title: info.title, excerpt: info.description, seo: pageSettings?.seo })
  : null;

const seo = buildSeo({
  title: title ?? pageSeo?.title,
  description:
    description ?? pageSeo?.description ?? settings?.seo?.description ?? settings?.description,
  image: image ?? shareImage(pageSettings?.seo) ?? shareImage(settings?.seo),
  pathname: Astro.url.pathname,
  site: Astro.site ?? Astro.url.origin,
  noindex: noindex ?? pageSeo?.noindex,
});

const site = String(Astro.site ?? Astro.url.origin);
// Site settings › Icon: PNGs built by src/pages/icons/[file].ts. Without it, /favicon.svg.
const hasIcon = !!settings?.favicon?.asset;
// Fixed pages describe themselves; project and post pages pass their own nodes (jsonLd).
const pageNodes = info
  ? [
      webPage({
        site,
        url: seo.canonical,
        type:
          info.key === "about"
            ? "AboutPage"
            : info.key === "work" || info.key === "journal"
              ? "CollectionPage"
              : "WebPage",
        name: seo.title,
        description: seo.description,
        summary: pageSettings?.aiSummary,
      }),
      ...(info.path === "/"
        ? []
        : [
            breadcrumbs([
              ["Home", new URL("/", site).href],
              [info.name, canonicalUrl(info.path, site)],
            ]),
          ]),
    ]
  : [];
const structuredData = serializeJsonLd(
  graph(
    organization({
      site,
      description: settings?.description,
      email: settings?.email,
      sameAs: settings?.social?.map((link) => link.href),
      logo: hasIcon ? new URL(iconPath("icon-512.png"), site).href : null,
      address: settings?.address,
    }),
    website(site),
    ...pageNodes,
    ...(jsonLd as Parameters<typeof graph>),
  ),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Before any stylesheet, so the canvas is never white on a first frame or mid-transition. */}
    <meta name="color-scheme" content="dark light" />
    {/* View Transition opt-in. Must stay inline and early: from the external stylesheet Chrome
        often read it too late and skipped the transition. */}
    <style is:inline>
      @view-transition {
        navigation: auto;
      }
      @media (prefers-reduced-motion: reduce) {
        @view-transition {
          navigation: none;
        }
      }
    </style>
    {/* Hold the first frame until the navbar is parsed, so a slow response can't drop it from
        the transition snapshot. Chromium only. */}
    <link rel="expect" href="#site-header" blocking="render" />
    {hasIcon ? (
      ICONS.filter((icon) => icon.rel).map((icon) => (
        <link
          rel={icon.rel}
          type="image/png"
          sizes={`${icon.size}x${icon.size}`}
          href={iconPath(icon.file)}
        />
      ))
    ) : (
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    )}
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    {/* Graphik is inlined in the stylesheet in builds, so it's only preloaded in dev. */}
    {import.meta.env.DEV && (
      <link rel="preload" href={graphikDevUrl} as="font" type="font/woff2" crossorigin />
    )}
    <link
      rel="preload"
      href="/fonts/geist/GeistMono-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {/* Entrance animation (motion.css), only after an in-site navigation; direct visits stay
        static for LCP. `nav-entered` hides sections; `nav-ready` fades them in once the view
        transition has finished AND fonts + on-screen images are decoded (that wait capped at 1s).
        "In-site" = a view transition on `pagereveal` (also covers Back/Forward and bfcache
        restores) or a same-origin referrer (browsers without cross-document transitions).
        The pointerdown/click pair: during a transition every click hits <html>, so a press skips
        the transition and re-sends the click to the element under the pointer. */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const pageReady = new Promise((resolve) => {
          addEventListener(
            "DOMContentLoaded",
            () => {
              const onScreen = [...document.querySelectorAll("main img")].filter(
                (img) => img.getBoundingClientRect().top < innerHeight,
              );
              Promise.all([
                document.fonts.ready,
                ...onScreen.map((img) => img.decode().catch(() => {})),
              ]).then(resolve);
            },
            { once: true },
          );
        });
        let inSite = false;
        try {
          const nav = performance.getEntriesByType("navigation")[0];
          inSite =
            nav?.type !== "reload" &&
            !!document.referrer &&
            new URL(document.referrer).origin === location.origin;
        } catch {
          /* Malformed referrer. */
        }
        const enter = (transitionDone) => {
          root.classList.remove("nav-ready");
          root.classList.add("nav-entered");
          const cap = new Promise((resolve) => setTimeout(resolve, 1000));
          Promise.all([transitionDone, Promise.race([pageReady, cap])]).then(() =>
            root.classList.add("nav-ready"),
          );
        };
        if ("onpagereveal" in window) {
          let transition = null;
          let revealed = false;
          addEventListener("pagereveal", (event) => {
            transition = event.viewTransition;
            if (transition) enter(transition.finished.catch(() => {}));
            else if (inSite && !revealed) enter(Promise.resolve());
            revealed = true;
          });
          let forward = false;
          addEventListener(
            "pointerdown",
            () => {
              if (!transition || !root.matches(":active-view-transition")) return;
              transition.skipTransition();
              forward = true;
            },
            true,
          );
          addEventListener(
            "click",
            (event) => {
              if (!forward) return;
              forward = false;
              if (event.target !== root) return;
              const target = document
                .elementFromPoint(event.clientX, event.clientY)
                ?.closest("a[href], button, summary, label, [role=button]");
              if (!target) return;
              event.stopPropagation();
              target.dispatchEvent(new MouseEvent("click", event));
            },
            true,
          );
          return;
        }
        if (inSite) enter(Promise.resolve());
      })();
    </script>
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {canonical && <link rel="canonical" href={seo.canonical} />}
    {seo.noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {settings?.googleSiteVerification && (
      <meta name="google-site-verification" content={settings.googleSiteVerification.trim()} />
    )}
    {settings?.bingSiteVerification && (
      <meta name="msvalidate.01" content={settings.bingSiteVerification.trim()} />
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    {canonical && <meta property="og:url" content={seo.canonical} />}
    {seo.image && (
      <>
        <meta property="og:image" content={seo.image} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta name="twitter:card" content={seo.image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    {seo.image && <meta name="twitter:image" content={seo.image} />}
    <script type="application/ld+json" set:html={structuredData} />
    {/* Page-specific head tags, e.g. the LCP image preload. */}
    <slot name="head" />
  </head>
  <body>
    {/* Start decoding Graphik now; Chromium otherwise waits for first layout and may paint
        the first frame in the fallback font. */}
    <script is:inline>
      document.fonts.load("500 1em Graphik");
    </script>
    <slot />
  </body>
</html>
