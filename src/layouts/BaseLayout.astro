---
/**
 * Base layout: document shell, fonts and SEO / social meta.
 * Defaults come from the Sanity siteSettings singleton, then from src/lib/seo.ts.
 */
import { sanityClient } from "sanity:client";
import { buildSeo, SITE_NAME } from "@/lib/seo";
import { graph, organization, serializeJsonLd, website } from "@/lib/structured-data";
import { urlFor } from "@/sanity/image";
import { SITE_SETTINGS_QUERY } from "@/sanity/queries";
import "@/styles/globals.css";

interface Props {
  /** Page title without the site name. Omit on the home page. */
  title?: string;
  description?: string | null;
  /** Absolute URL of a 1200 × 630 social image. Defaults to the site settings image. */
  image?: string | null;
  /** Ask search engines not to list the page (SEO › Hide from search engines). */
  noindex?: boolean;
  /** Open Graph type: "article" for Journal posts. */
  ogType?: "website" | "article";
  /**
   * Page-specific structured data nodes (src/lib/structured-data.ts). The organisation and
   * website nodes are added on every page, so page nodes can reference them.
   */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, image, noindex, ogType = "website", jsonLd = [] } = Astro.props;

const settings = await sanityClient.fetch(SITE_SETTINGS_QUERY);
const defaultImage = settings?.seo?.image?.asset
  ? urlFor(settings.seo.image).width(1200).height(630).fit("crop").url()
  : null;

const seo = buildSeo({
  title,
  description: description ?? settings?.seo?.description ?? settings?.description,
  image: image ?? defaultImage,
  pathname: Astro.url.pathname,
  site: Astro.site ?? Astro.url.origin,
  noindex,
});

const site = String(Astro.site ?? Astro.url.origin);
const structuredData = serializeJsonLd(
  graph(
    organization({
      site,
      description: settings?.description,
      email: settings?.email,
      sameAs: settings?.social?.map((link) => link.href),
    }),
    website(site),
    ...(jsonLd as Parameters<typeof graph>),
  ),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Cross-document View Transition opt-in (src/styles/motion.css). Inline and first on
         purpose: Chrome reads the opt-in as soon as the new page may render, and from the
         external stylesheet it often wasn't applied yet, so the transition was skipped. -->
    <style is:inline>
      @view-transition {
        navigation: auto;
      }
      @media (prefers-reduced-motion: reduce) {
        @view-transition {
          navigation: none;
        }
      }
    </style>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <!-- Self-hosted fonts (public/fonts/). Both are used above the fold, so preload them. -->
    <link
      rel="preload"
      href="/fonts/graphik/Graphik_Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/geist/GeistMono-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Entrance animation only after an in-site navigation (src/styles/motion.css).
         Runs before first paint; direct visits and reloads (which keep the referrer) stay
         static so LCP isn't delayed. -->
    <script is:inline>
      try {
        const nav = performance.getEntriesByType("navigation")[0];
        if (
          nav?.type !== "reload" &&
          document.referrer &&
          new URL(document.referrer).origin === location.origin
        ) {
          document.documentElement.classList.add("nav-entered");
        }
      } catch {
        /* Malformed referrer: no entrance. */
      }
    </script>
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {seo.noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    {seo.image && <meta property="og:image" content={seo.image} />}
    <meta name="twitter:card" content={seo.image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    {seo.image && <meta name="twitter:image" content={seo.image} />}
    <script type="application/ld+json" set:html={structuredData} />
    <!-- Page-specific head tags, e.g. the LCP image preload on project pages. -->
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
