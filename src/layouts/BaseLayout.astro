---
/**
 * Base layout: document shell, fonts and SEO / social meta.
 * Defaults come from the Sanity siteSettings singleton, then from src/lib/seo.ts.
 */
import { sanityClient } from "sanity:client";
import { buildSeo, SITE_NAME } from "@/lib/seo";
import { urlFor } from "@/sanity/image";
import { SITE_SETTINGS_QUERY } from "@/sanity/queries";
import "@/styles/globals.css";

interface Props {
  /** Page title without the site name. Omit on the home page. */
  title?: string;
  description?: string | null;
  /** Absolute URL of a 1200 × 630 social image. Defaults to the site settings image. */
  image?: string | null;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;

const settings = await sanityClient.fetch(SITE_SETTINGS_QUERY);
const defaultImage = settings?.seo?.image?.asset
  ? urlFor(settings.seo.image).width(1200).height(630).fit("crop").url()
  : null;

const seo = buildSeo({
  title,
  description: description ?? settings?.seo?.description ?? settings?.description,
  image: image ?? defaultImage,
  pathname: Astro.url.pathname,
  site: Astro.site ?? Astro.url.origin,
  noindex,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <!-- Self-hosted fonts (public/fonts/). Both are used above the fold, so preload them. -->
    <link
      rel="preload"
      href="/fonts/graphik/Graphik_Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/geist/GeistMono-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Entrance animation only after an in-site navigation (src/styles/motion.css).
         Runs before first paint; direct visits stay static so LCP isn't delayed. -->
    <script is:inline>
      try {
        if (document.referrer && new URL(document.referrer).origin === location.origin) {
          document.documentElement.classList.add("nav-entered");
        }
      } catch {
        /* Malformed referrer: no entrance. */
      }
    </script>
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    {seo.image && <meta property="og:image" content={seo.image} />}
    <meta name="twitter:card" content={seo.image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    {seo.image && <meta name="twitter:image" content={seo.image} />}
    <!-- Page-specific head tags, e.g. the LCP image preload on project pages. -->
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
