---
/**
 * About Principles Section
 * "Our how": header and a principles accordion (Headline MD triggers) in columns 1–5 at xl,
 * with the header at the top and the accordion bottom-aligned to a square visual in 7–12.
 * Stacked below xl (header, accordion, visual). The visual is set in code, not Sanity: for now
 * a bg-secondary placeholder with a 4px radius (rounded-sm).
 * Figma: About / breakpoint=xl (frame 5044:17639), "our how"
 */
import { cn } from "@/lib/utils";
import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from "@/ui/accordion";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const principles = [
  {
    title: "Taste is the work",
    text: "Making things has never been easier, knowing which one is right still isn't. We explore widely, with every tool we have, and spend our real effort on deciding.",
  },
  {
    title: "A few projects at a time",
    text: "We stay small by choice and take on only as much as we can do properly. You get our full attention, not a slot in a schedule.",
  },
  {
    title: "The right people, not the available ones",
    text: "Four of us at the core, and a network of senior specialists we've worked with for years. Each project gets the team it needs, from the first meeting to launch.",
  },
  {
    title: "Made to be continued.",
    text: "We hand over systems, not files: documented, structured and ready for your team and its AI tools to keep building on. The work should get better after we leave, not drift.",
  },
];
---

<section aria-labelledby="our-how" class={cn("px-container pb-section", className)}>
  <p class="border-t border-border-subtle py-6 text-eyebrow text-fg-primary uppercase">Our how</p>
  <div class="grid-cols-layout gap-y-12 pt-20">
    <div class="col-span-full flex flex-col gap-12 xl:col-span-5 xl:justify-between">
      <h2 id="our-how" class="text-headline-xl text-fg-primary">
        The fundamental principles that shape our studio
      </h2>
      <Accordion>
        {principles.map((principle) => (
          <AccordionItem value={principle.title}>
            <AccordionTrigger size="md">{principle.title}</AccordionTrigger>
            <AccordionContent>{principle.text}</AccordionContent>
          </AccordionItem>
        ))}
      </Accordion>
    </div>
    <div
      aria-hidden="true"
      class="col-span-full aspect-square rounded-sm bg-bg-secondary xl:col-span-6 xl:col-start-7"
    ></div>
  </div>
</section>
