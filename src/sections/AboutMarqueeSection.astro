---
/**
 * About Marquee Section
 * Studio photos under the About hero: a horizontal strip of 3:2 visuals (320px wide at base,
 * 576px at md, 1024px at xl, 8px apart) that scrolls on its own in a seamless loop, like
 * permanent.is. It can also be scrolled by hand (touchpad, touchscreen, keyboard) and dragged
 * with the mouse; autoplay picks up again after the user lets go.
 * Figma: https://www.figma.com/design/xqG6nM7oVW4iev0PrbuqWt/?node-id=5044-17901
 *
 * - Each item is a Media (image or video). Without items it shows 6 placeholder blocks, until
 *   the photos are added in Site settings › About page.
 * - The list is rendered three times (the copies are aria-hidden and inert); the script keeps
 *   the scroll position inside the middle copy, so the loop has no seam.
 * - The first item of the middle copy starts centred, as in Figma. A tiny inline script sets
 *   that position before the first paint; the bundled script below runs the autoplay.
 * - Under prefers-reduced-motion there is no autoplay, but scrolling and dragging still work.
 * - Autoplay stops while the strip is off screen, or while it or a control has keyboard focus.
 * - Previous / next buttons (WCAG: a way to move it without dragging) sit on the strip's
 *   vertical centre, inset by the container padding. They are invisible until the strip is
 *   hovered with a mouse or a button gets keyboard focus; each press moves one item.
 *   Same look as the video control (they sit on imagery, so the same in both themes).
 * - Speed and resume delay are tokens (--motion-marquee-*, tokens.css).
 */
import Media from "@/components/Media.astro";
import { cn } from "@/lib/utils";
import type { MediaData } from "@/sanity/media";

interface Props {
  /** Visuals, left to right. Empty: 6 placeholders. */
  items: MediaData[];
  /** Accessible name of the strip. */
  label?: string;
  class?: string;
}

const { items, label = "Studio photos", class: className } = Astro.props;

const PLACEHOLDERS = 6;
const COPIES = 3;
const slots: (MediaData | null)[] = items.length > 0 ? items : Array(PLACEHOLDERS).fill(null);
const sizes = "(min-width: 64rem) 1024px, (min-width: 48rem) 576px, 320px";
---

<section aria-label={label} class={cn("pb-section", className)}>
  <div class="group/marquee relative">
    {/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- scrollable region must be focusable (axe scrollable-region-focusable) */}
    <ul
      data-slot="marquee"
      tabindex="0"
      aria-label={label}
      class="flex cursor-grab gap-gutter overflow-x-auto overscroll-x-contain scrollbar-none outline-none select-none focus-visible:ring-2 focus-visible:ring-interactive-focus-ring focus-visible:ring-inset data-dragging:cursor-grabbing *:w-80 *:shrink-0 md:*:w-144 xl:*:w-256"
    >
      {Array.from({ length: COPIES }, (_, copy) =>
        slots.map((media, i) => (
          <li
            data-marquee-start={copy === 1 && i === 0 ? "" : undefined}
            aria-hidden={copy === 1 ? undefined : "true"}
            inert={copy !== 1}
          >
            {media ? (
              <Media media={media} aspect="gallery" sizes={sizes} />
            ) : (
              <div class="aspect-3/2 rounded-sm bg-bg-secondary" />
            )}
          </li>
        )),
      )}
    </ul>
    {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
    <script is:inline>
      // Start with the middle copy's first item centred (before the first paint).
      (function (track) {
        const start = track.querySelector("[data-marquee-start]");
        track.scrollLeft = start.offsetLeft - (track.clientWidth - start.offsetWidth) / 2;
      })(document.currentScript.previousElementSibling);
    </script>
    {/* Previous / next: hidden until the strip is hovered (mouse) or a control has keyboard focus. */}
    <div class="pointer-events-none absolute inset-x-0 top-1/2 flex -translate-y-1/2 justify-between px-container">
      {(["previous", "next"] as const).map((direction) => (
        <button
          type="button"
          data-marquee-step={direction === "next" ? "1" : "-1"}
          aria-label={direction === "next" ? "Next" : "Previous"}
          class="pointer-events-auto grid size-6 cursor-pointer place-items-center rounded-xs bg-neutral-900/40 text-neutral-50 opacity-0 backdrop-blur-sm transition-[opacity,background-color] hover:bg-neutral-900/60 focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-interactive-focus-ring active:bg-neutral-900/60 pointer-fine:group-hover/marquee:opacity-100"
        >
          <svg
            aria-hidden="true"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            class={direction === "previous" ? "-scale-x-100" : undefined}
          >
            <path d="M10.5 8.5 14 12l-3.5 3.5" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>("[data-slot=marquee]").forEach((track) => {
    const items = [...track.children] as HTMLElement[];
    const perCopy = items.length / 3;
    const styles = getComputedStyle(track);
    // Time token in ms. The CSS minifier may rewrite "1500ms" as "1.5s", so read the unit too.
    const ms = (name: string) => {
      const value = styles.getPropertyValue(name).trim();
      const n = parseFloat(value) || 0;
      return value.endsWith("ms") ? n : value.endsWith("s") ? n * 1000 : n;
    };
    const speed = parseFloat(styles.getPropertyValue("--motion-marquee-speed")) || 0; // px/s
    const resume = ms("--motion-marquee-resume");

    /** Width of one copy of the list, gap included. */
    let loop = 0;
    const measure = () => {
      loop = items[perCopy]!.offsetLeft - items[0]!.offsetLeft;
    };
    measure();

    // Scroll position as a float: browsers round scrollLeft, so the fraction is drawn with a
    // transform, which keeps slow autoplay smooth.
    let pos = track.scrollLeft;
    let written = track.scrollLeft;
    const write = (next: number, subpixel = false) => {
      pos = next;
      track.scrollLeft = next;
      written = track.scrollLeft;
      const rest = subpixel ? written - pos : 0;
      for (const item of items) item.style.translate = rest ? `${rest}px 0` : "";
    };

    /** Keeps the position inside the middle copy (both edges have a full copy to spare). */
    const wrap = (lo: number, hi: number) => {
      if (pos < lo) write(pos + loop);
      else if (pos >= hi) write(pos - loop);
    };

    // --- Interaction: anything the user does pauses autoplay until `resume` after it ends.
    let holding = false; // finger or mouse button down
    let lastInput = -Infinity;
    const touch = () => {
      lastInput = performance.now();
    };

    track.addEventListener("scroll", () => {
      if (Math.abs(track.scrollLeft - written) < 1) return; // our own write
      // Native scroll (touchpad, touch momentum, keyboard): follow it, and only wrap near the
      // ends, because moving scrollLeft cancels momentum on iOS.
      pos = written = track.scrollLeft;
      for (const item of items) item.style.translate = "";
      touch();
      wrap(loop / 2, 2.5 * loop - track.clientWidth);
    });
    track.addEventListener("touchstart", () => ((holding = true), touch()), { passive: true });
    track.addEventListener("touchend", () => ((holding = false), touch()));
    track.addEventListener("touchcancel", () => ((holding = false), touch()));
    track.addEventListener(
      "wheel",
      (event) => Math.abs(event.deltaX) > Math.abs(event.deltaY) && touch(),
      { passive: true },
    );
    track.addEventListener("keydown", touch);

    // Mouse drag, with a little momentum on release.
    let dragX = 0;
    let dragPos = 0;
    let velocity = 0; // px per ms, positive = towards the end
    let lastMove = 0;
    let glide = 0; // rAF id of the release momentum
    track.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "mouse" || event.button !== 0) return;
      // Controls inside an item (the video play/pause button) keep their own click.
      if ((event.target as Element).closest("button, a")) return;
      cancelAnimationFrame(glide);
      holding = true;
      dragX = event.clientX;
      dragPos = pos;
      velocity = 0;
      lastMove = event.timeStamp;
      track.setPointerCapture(event.pointerId);
      track.dataset.dragging = "";
      touch();
    });
    track.addEventListener("pointermove", (event) => {
      if (!track.hasPointerCapture(event.pointerId)) return;
      const next = dragPos - (event.clientX - dragX);
      const dt = event.timeStamp - lastMove;
      if (dt > 0) velocity = (next - pos) / dt;
      lastMove = event.timeStamp;
      write(next);
      wrap(loop / 2, 2.5 * loop - track.clientWidth);
      dragPos += pos - next; // keep the drag anchored after a wrap
      touch();
    });
    const release = (event: PointerEvent) => {
      if (!track.hasPointerCapture(event.pointerId)) return;
      track.releasePointerCapture(event.pointerId);
      delete track.dataset.dragging;
      holding = false;
      touch();
      if (event.timeStamp - lastMove > 100) velocity = 0; // held still before letting go
      let last = performance.now();
      const step = (now: number) => {
        const dt = now - last;
        last = now;
        velocity *= Math.pow(0.95, dt / 16);
        if (Math.abs(velocity) < 0.02) return;
        write(pos + velocity * dt);
        wrap(loop / 2, 2.5 * loop - track.clientWidth);
        touch();
        glide = requestAnimationFrame(step);
      };
      glide = requestAnimationFrame(step);
    };
    track.addEventListener("pointerup", release);
    track.addEventListener("pointercancel", release);
    // Images are not draggable as files while dragging the strip.
    track.addEventListener("dragstart", (event) => event.preventDefault());

    // Previous / next: one item (plus gap) per press, animated by the browser unless reduced motion.
    const root = track.parentElement!;
    root.querySelectorAll<HTMLButtonElement>("[data-marquee-step]").forEach((button) => {
      button.addEventListener("click", () => {
        cancelAnimationFrame(glide);
        touch();
        const step = items[1]!.offsetLeft - items[0]!.offsetLeft;
        track.scrollBy({
          left: Number(button.dataset.marqueeStep) * step,
          behavior: reducedMotion.matches ? "instant" : "smooth",
        });
      });
    });

    // --- Autoplay: runs while on screen, without reduced motion, and without keyboard focus.
    let visible = false;
    let frame = 0;
    let previous = 0;
    const tick = (now: number) => {
      const dt = previous ? Math.min(now - previous, 100) : 0;
      previous = now;
      const idle = now - lastInput;
      const paused = holding || root.querySelector(":focus-visible") !== null || idle < resume;
      if (!paused && speed > 0) {
        // Ease back up to speed over `resume` ms after the user lets go.
        const ramp =
          resume > 0 && lastInput > -Infinity ? Math.min((idle - resume) / resume, 1) : 1;
        const eased = ramp * ramp * (3 - 2 * ramp);
        write(pos + (speed * eased * dt) / 1000, true);
        wrap(loop, 2 * loop);
      }
      frame = requestAnimationFrame(tick);
    };
    const update = () => {
      cancelAnimationFrame(frame);
      previous = 0;
      if (visible && !reducedMotion.matches) frame = requestAnimationFrame(tick);
    };
    new IntersectionObserver(([entry]) => {
      visible = entry!.isIntersecting;
      update();
    }).observe(track);
    reducedMotion.addEventListener("change", update);

    // Item widths change at the breakpoints: keep the same spot in the loop.
    new ResizeObserver(() => {
      const ratio = loop ? pos / loop : 0;
      measure();
      write(ratio * loop);
    }).observe(items[0]!);
  });
</script>
