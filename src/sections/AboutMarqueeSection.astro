---
/**
 * About Marquee Section
 * Studio photos under the About hero: a horizontal strip of 3:2 visuals (320px wide at base,
 * 576px at md, 1024px at xl, 8px apart) that scrolls on its own in a seamless loop, like
 * permanent.is. It can also be scrolled by hand (touchpad, touchscreen, keyboard) and dragged
 * with the mouse; autoplay picks up again after the user lets go.
 * Figma: https://www.figma.com/design/xqG6nM7oVW4iev0PrbuqWt/?node-id=5044-17901
 *
 * - Each item is a Media (image or video). Without items it shows 6 placeholder blocks, until
 *   the photos are added in Site settings › About page.
 * - The list is rendered four times (the extra copies are aria-hidden and inert), so the loop
 *   has no seam.
 * - Autoplay is a CSS animation (compositor-driven, so it stays smooth even when the page is
 *   busy): every item slides left by one copy's width and repeats. The script only measures
 *   that width (and from the speed token, the duration) and pauses the animation while the
 *   user scrolls, drags or presses a control, until `--motion-marquee-resume` after they stop.
 * - Hand scrolling (touchpad, touchscreen, keyboard) is native scrolling on top of the
 *   animation; the script wraps the scroll position by one copy near the ends, so it never
 *   runs out. Mouse drag (with a little momentum) is the only part the script moves itself.
 * - The first item of the second copy starts centred, as in Figma. A tiny inline script sets
 *   that position before the first paint.
 * - Under prefers-reduced-motion there is no autoplay, but scrolling and dragging still work.
 * - Autoplay pauses while the strip or a control has keyboard focus.
 * - Previous / next buttons (WCAG: a way to move it without dragging) sit on the strip's
 *   vertical centre, inset by the container padding. They are invisible until the strip is
 *   hovered with a mouse or a button gets keyboard focus; each press centres the next (or
 *   previous) item in the strip.
 *   Same look as the video control (they sit on imagery, so the same in both themes).
 * - Speed and resume delay are tokens (--motion-marquee-*, tokens.css).
 */
import Media from "@/components/Media.astro";
import type { MediaData } from "@/sanity/media";

interface Props {
  /** Visuals, left to right. Empty: 6 placeholders. */
  items: MediaData[];
  /** Accessible name of the strip. */
  label?: string;
  class?: string;
}

const { items, label = "Studio photos", class: className } = Astro.props;

const PLACEHOLDERS = 6;
const COPIES = 4;
const slots: (MediaData | null)[] = items.length > 0 ? items : Array(PLACEHOLDERS).fill(null);
const sizes = "(min-width: 64rem) 1024px, (min-width: 48rem) 576px, 320px";
---

<section aria-label={label} class={className}>
  <div class="group/marquee relative">
    {/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- scrollable region must be focusable (axe scrollable-region-focusable) */}
    <ul
      data-slot="marquee"
      tabindex="0"
      aria-label={label}
      style={`--marquee-count: ${slots.length}`}
      class="flex cursor-grab gap-gutter overflow-x-auto overscroll-x-contain scrollbar-none outline-none select-none focus-visible:ring-2 focus-visible:ring-interactive-focus-ring focus-visible:ring-inset data-dragging:cursor-grabbing *:w-80 *:shrink-0 md:*:w-144 xl:*:w-256"
    >
      {Array.from({ length: COPIES }, (_, copy) =>
        slots.map((media, i) => (
          <li
            data-marquee-start={copy === 1 && i === 0 ? "" : undefined}
            aria-hidden={copy === 1 ? undefined : "true"}
            inert={copy !== 1}
          >
            {media ? (
              <Media media={media} aspect="gallery" sizes={sizes} />
            ) : (
              <div class="aspect-3/2 rounded-sm bg-bg-secondary" />
            )}
          </li>
        )),
      )}
    </ul>
    {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
    <script is:inline>
      // Start with the middle copy's first item centred (before the first paint).
      (function (track) {
        const start = track.querySelector("[data-marquee-start]");
        track.scrollLeft = start.offsetLeft - (track.clientWidth - start.offsetWidth) / 2;
      })(document.currentScript.previousElementSibling);
    </script>
    {/* Previous / next: hidden until the strip is hovered (mouse) or a control has keyboard focus. */}
    <div class="pointer-events-none absolute inset-x-0 top-1/2 flex -translate-y-1/2 justify-between px-container">
      {(["previous", "next"] as const).map((direction) => (
        <button
          type="button"
          data-marquee-step={direction === "next" ? "1" : "-1"}
          aria-label={direction === "next" ? "Next" : "Previous"}
          class="pointer-events-auto grid size-6 cursor-pointer place-items-center rounded-xs bg-bg-translucent text-fg-primary/65 opacity-0 backdrop-blur-sm transition-[opacity,background-color,color] hover:bg-interactive-secondary-active hover:text-fg-primary focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-interactive-focus-ring active:bg-interactive-secondary-active active:text-fg-primary pointer-fine:group-hover/marquee:opacity-100"
        >
          <svg
            aria-hidden="true"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            class={direction === "previous" ? "-scale-x-100" : undefined}
          >
            <path d="M10.5 8.5 14 12l-3.5 3.5" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>
      ))}
    </div>
  </div>
</section>

<style>
  /* Autoplay: each item slides left by one copy of the list (--marquee-loop, set by the script
   * with --marquee-duration), then repeats; the copies make the jump back invisible. */
  @keyframes marquee {
    to {
      translate: calc(-1 * var(--marquee-loop)) 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-slot="marquee"][data-ready] > li {
      animation: marquee var(--marquee-duration) linear infinite;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>("[data-slot=marquee]").forEach((track) => {
    const items = [...track.children] as HTMLElement[];
    const perCopy = items.length / 4;
    const styles = getComputedStyle(track);
    // Time token in ms. The CSS minifier may rewrite "1500ms" as "1.5s", so read the unit too.
    const value = styles.getPropertyValue("--motion-marquee-resume").trim();
    const resume = (parseFloat(value) || 0) * (value.endsWith("ms") ? 1 : 1000);
    const speed = parseFloat(styles.getPropertyValue("--motion-marquee-speed")) || 0; // px/s

    /** Width of one copy of the list, gap included. Sets the animation's distance and duration. */
    let loop = 0;
    const measure = () => {
      loop = items[perCopy]!.offsetLeft - items[0]!.offsetLeft;
      track.style.setProperty("--marquee-loop", `${loop}px`);
      track.style.setProperty("--marquee-duration", `${speed > 0 ? loop / speed : 0}s`);
    };
    measure();
    new ResizeObserver(measure).observe(items[0]!);
    if (speed > 0) track.dataset.ready = "";

    // --- Pause while the user is interacting (and until `resume` ms after they stop), and while
    // the strip or a control has keyboard focus. Paused through the Web Animations API rather
    // than animation-play-state: it freezes the offset at once, so a control press can centre
    // an item exactly.
    const root = track.parentElement!;
    let holding = false; // finger or mouse button down
    let waiting = false; // within `resume` ms of the last input
    let focused = false;
    let timer = 0;
    const sync = () => {
      const pause = holding || waiting || focused;
      for (const item of items) {
        for (const animation of item.getAnimations()) {
          if (pause && animation.playState !== "paused") {
            // pause() only takes effect on the next frame; setting the time completes it now.
            const time = animation.currentTime;
            animation.pause();
            animation.currentTime = time;
          } else if (!pause) animation.play();
        }
      }
    };
    const onFocus = () =>
      queueMicrotask(() => {
        focused = root.querySelector(":focus-visible") !== null;
        sync();
      });
    root.addEventListener("focusin", onFocus);
    root.addEventListener("focusout", onFocus);
    const touch = () => {
      waiting = true;
      sync();
      clearTimeout(timer);
      if (!holding) {
        timer = window.setTimeout(() => {
          waiting = false;
          sync();
        }, resume);
      }
    };

    /** Keeps scrollLeft away from both ends (by a quarter copy), one copy at a time. */
    const wrap = () => {
      const max = track.scrollWidth - track.clientWidth - loop - loop / 4;
      if (track.scrollLeft < loop / 4) track.scrollLeft += loop;
      else if (track.scrollLeft > max) track.scrollLeft -= loop;
    };

    // Native scroll (touchpad, touch, keyboard, drag, the buttons) pauses autoplay and wraps.
    track.addEventListener("scroll", () => (touch(), wrap()), { passive: true });
    track.addEventListener("touchstart", () => ((holding = true), touch()), { passive: true });
    const lift = () => ((holding = false), touch());
    track.addEventListener("touchend", lift);
    track.addEventListener("touchcancel", lift);

    // Mouse drag, with a little momentum on release.
    let dragX = 0;
    let velocity = 0; // px per ms, positive = towards the end
    let lastMove = 0;
    let glide = 0; // rAF id of the release momentum
    track.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "mouse" || event.button !== 0) return;
      // Controls inside an item (the video play/pause button) keep their own click.
      if ((event.target as Element).closest("button, a")) return;
      cancelAnimationFrame(glide);
      holding = true;
      dragX = event.clientX;
      velocity = 0;
      lastMove = event.timeStamp;
      track.setPointerCapture(event.pointerId);
      track.dataset.dragging = "";
      touch();
    });
    track.addEventListener("pointermove", (event) => {
      if (!track.hasPointerCapture(event.pointerId)) return;
      const delta = dragX - event.clientX;
      const dt = event.timeStamp - lastMove;
      if (dt > 0) velocity = delta / dt;
      dragX = event.clientX;
      lastMove = event.timeStamp;
      track.scrollLeft += delta;
    });
    const release = (event: PointerEvent) => {
      if (!track.hasPointerCapture(event.pointerId)) return;
      track.releasePointerCapture(event.pointerId);
      delete track.dataset.dragging;
      holding = false;
      touch();
      if (event.timeStamp - lastMove > 100) velocity = 0; // held still before letting go
      let last = performance.now();
      const step = (now: number) => {
        const dt = now - last;
        last = now;
        velocity *= Math.pow(0.95, dt / 16);
        if (Math.abs(velocity) < 0.02) return;
        track.scrollLeft += velocity * dt;
        glide = requestAnimationFrame(step);
      };
      glide = requestAnimationFrame(step);
    };
    track.addEventListener("pointerup", release);
    track.addEventListener("pointercancel", release);
    // Images are not draggable as files while dragging the strip.
    track.addEventListener("dragstart", (event) => event.preventDefault());

    // Scroll offsets snap to whole (device) pixels, the animated offset doesn't: when a press has
    // finished scrolling, shift the paused animation by the leftover fraction, so the item is
    // centred exactly. Only for sub-pixel leftovers, never a visible jump.
    let stepping = false;
    track.addEventListener("scrollend", () => {
      if (!stepping) return;
      const box = track.getBoundingClientRect();
      const centre = box.left + box.width / 2;
      const offset = items
        .map((item) => {
          const rect = item.getBoundingClientRect();
          return rect.left + rect.width / 2 - centre;
        })
        .reduce((a, b) => (Math.abs(b) < Math.abs(a) ? b : a));
      // Still on the way (e.g. the jump into the second copy ended first): wait for the next.
      if (Math.abs(offset) > 1) return;
      stepping = false;
      if (speed <= 0 || Math.abs(offset) < 0.01) return;
      for (const item of items) {
        for (const animation of item.getAnimations()) {
          const duration = Number(animation.effect?.getComputedTiming().duration) || 0;
          let time = Number(animation.currentTime) + (offset / speed) * 1000;
          if (time < 0) time += duration;
          animation.currentTime = time;
        }
      }
    });

    // Previous / next: centre the item after (or before) the one nearest the centre, animated
    // by the browser unless reduced motion. Autoplay is paused first (touch), so the animated
    // offset holds still while the strip scrolls to it.
    root.querySelectorAll<HTMLButtonElement>("[data-marquee-step]").forEach((button) => {
      button.addEventListener("click", () => {
        cancelAnimationFrame(glide);
        touch();
        // Move into the second copy first, so the scroll below never needs wrapping (which
        // would cut the smooth scroll short). The copies look the same, so this is invisible.
        if (track.scrollLeft < loop) track.scrollLeft += loop;
        else if (track.scrollLeft >= 2 * loop) track.scrollLeft -= loop;

        const box = track.getBoundingClientRect();
        const centre = box.left + box.width / 2;
        const step = items[1]!.offsetLeft - items[0]!.offsetLeft;
        const offsets = items.map((item) => {
          const rect = item.getBoundingClientRect(); // includes the autoplay translate
          return rect.left + rect.width / 2 - centre;
        });
        const target =
          button.dataset.marqueeStep === "1"
            ? offsets.find((offset) => offset > step / 2)
            : offsets.findLast((offset) => offset < -step / 2);
        if (target === undefined) return;
        stepping = true;
        track.scrollBy({
          left: target,
          behavior: reducedMotion.matches ? "instant" : "smooth",
        });
      });
    });
  });
</script>
