---
/**
 * Services Overview Section
 * Home page "Our services": eyebrow, header with an "Explore more" button, and one row per
 * service (showreel, name, description, chevron; on base the chevron sits beside the description) linking to its /services anchor.
 * Figma: https://www.figma.com/design/xqG6nM7oVW4iev0PrbuqWt/?node-id=5039-7476
 *
 * Each row's visual is a 4:3 showreel video defined in code (src/lib/showreels.ts), not
 * Sanity. Rows without a video yet show the bg-secondary placeholder. The whole row is
 * clickable through a stretched title link, so the video's pause button isn't nested in it.
 *
 * Indicator: Figma "Indicator" (rounded-xs box, interactive-secondary, hover
 * interactive-secondary-hover) with its chevron drawn inline in currentColor. The box transitions
 * only its background: the chevron inherits the row's already-transitioning color, and a second
 * color transition on the box would make it lag behind the text.
 * Scroll highlight (all devices): the row under the middle of the viewport is the active one.
 * A script marks it data-active (indicator in its hover colour) and the other rows data-dimmed
 * (fg-tertiary) as the page scrolls. Rows above the first or below the last keep the first or
 * last row active. Without JS every row stays fg-primary.
 * Hover (devices with a cursor) wins while the pointer is over the list: the hovered row is
 * fg-primary with its indicator in the hover colour, the other rows dim, and the scroll state is
 * ignored (not-group-hover/list). hover: variants only match @media (hover: hover).
 */
import Media from "@/components/Media.astro";
import { SERVICES } from "@/lib/services";
import { SHOWREELS, type Showreel, type ServiceValue } from "@/lib/showreels";
import { cn } from "@/lib/utils";
import { Button } from "@/ui/button";

interface Props {
  /** Showreel per service. Defaults to SHOWREELS; the styleguide passes its own. */
  showreels?: Record<ServiceValue, Showreel>;
  class?: string;
}

const { showreels = SHOWREELS, class: className } = Astro.props;

// Row labels: "Web" is shorter than the service title "Website" (as on the Services page bar).
const LABELS: Record<ServiceValue, string> = {
  brand: "Brand",
  web: "Web",
  "digital-products": "Product",
};
---

<section aria-labelledby="services-overview" class={cn("px-container pb-section", className)}>
  <h2
    id="services-overview"
    class="border-t border-border-subtle py-6 text-eyebrow text-fg-primary uppercase"
  >
    Our services
  </h2>
  <div class="flex flex-col gap-20 pt-20">
    <div class="grid-cols-layout">
      <div class="col-span-full flex flex-col items-start gap-12 md:col-span-8 xl:col-span-6">
        <p class="text-headline-xl text-fg-primary">
          Your customers see one company and we design it that way.
        </p>
        <Button as="a" href="/services" variant="secondary">
          Explore more
        </Button>
      </div>
    </div>
    <ul
      data-slot="services-overview"
      class="group/list animate-enter-stagger divide-y divide-border-subtle"
    >
      {SERVICES.map((service) => (
        <li class="group relative grid-cols-layout not-group-hover/list:data-dimmed:text-fg-tertiary items-center gap-y-2 rounded-sm py-4 text-fg-primary transition-colors duration-300 ease-in-out group-hover/list:[&:not(:hover)]:text-fg-tertiary has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-interactive-focus-ring has-[a:focus-visible]:ring-offset-2 has-[a:focus-visible]:ring-offset-bg-primary">
          <div class="hidden self-start pr-6 md:col-span-3 md:block xl:col-span-2">
            <Media
              video={showreels[service.value]}
              aspect="thumbnail"
              sizes="(min-width: 64rem) 192px, 25vw"
              class="max-w-48"
            />
          </div>
          <a
            href={`/services#${service.anchor}`}
            class="col-span-4 text-headline-lg outline-none after:absolute after:inset-0 md:col-span-2"
          >
            {LABELS[service.value]}
          </a>
          <div class="col-span-8 flex items-center gap-4 md:contents">
            <span class="flex-1 text-body-sm md:col-span-5 md:text-body-md xl:col-span-6 xl:col-start-6">
              {service.description}
            </span>
            <span class="flex md:col-start-12 md:justify-self-end">
              <span class="flex size-6 items-center justify-center rounded-xs bg-interactive-secondary transition-[background-color] duration-300 ease-in-out group-hover:bg-interactive-secondary-hover group-has-[a:focus-visible]:bg-interactive-secondary-hover not-group-hover/list:group-data-active:bg-interactive-secondary-hover">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.25"
                  class="size-6"
                  aria-hidden="true"
                >
                  <path d="M10 8l4 4-4 4" />
                </svg>
              </span>
            </span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Highlight the row under the middle of the viewport, dim the rest.
  for (const list of document.querySelectorAll<HTMLElement>('[data-slot="services-overview"]')) {
    const rows = [...list.children] as HTMLElement[];
    let frame = 0;

    const update = () => {
      frame = 0;
      const middle = innerHeight / 2;
      let active = 0;
      rows.forEach((row, index) => {
        if (row.getBoundingClientRect().top <= middle) active = index;
      });
      rows.forEach((row, index) => {
        row.toggleAttribute("data-active", index === active);
        row.toggleAttribute("data-dimmed", index !== active);
      });
    };
    const schedule = () => {
      frame ||= requestAnimationFrame(update);
    };

    // Track scrolling only while the list is on screen.
    new IntersectionObserver(([entry]) => {
      if (entry?.isIntersecting) {
        addEventListener("scroll", schedule, { passive: true });
        addEventListener("resize", schedule);
        schedule();
      } else {
        removeEventListener("scroll", schedule);
        removeEventListener("resize", schedule);
      }
    }).observe(list);
  }
</script>
