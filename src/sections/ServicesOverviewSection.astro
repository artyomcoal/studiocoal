---
/**
 * Services Overview Section
 * Home page "Our services": eyebrow, header with an "Explore more" button, and one row per
 * service (showreel, name, description, chevron; on base the chevron sits beside the description) linking to its /services anchor.
 * Figma: https://www.figma.com/design/xqG6nM7oVW4iev0PrbuqWt/?node-id=5039-7476
 *
 * Each row's visual is a 4:3 showreel video defined in code (src/lib/showreels.ts), not
 * Sanity. Rows without a video yet show the bg-secondary placeholder. The whole row is
 * clickable through a stretched title link, so the video's pause button isn't nested in it.
 *
 * Indicator: Figma "Indicator" (rounded-xs box, interactive-secondary, hover
 * interactive-secondary-hover) with its chevron drawn inline in currentColor. The box transitions
 * only its background: the chevron inherits the row's already-transitioning color, and a second
 * color transition on the box would make it lag behind the text.
 * Default: every row is fg-primary.
 * Hover (devices with a cursor): the hovered row stays fg-primary with its indicator in the hover
 * colour; the other rows dim to fg-secondary, chevron included (currentColor). hover: variants
 * only match @media (hover: hover).
 * Touch (@media (hover: none)), via the script below:
 *   - Scroll highlight: while a row crosses the middle of the viewport it is data-active
 *     (indicator in its hover colour) and the others are data-dimmed (fg-secondary). When the
 *     list is wholly above or below the middle, no row is highlighted and all are fg-primary.
 *   - Tap: the touched row becomes active and the others dim, same as hover. It holds until the
 *     page scrolls again; if the touch turns into a scroll (pointercancel) it is dropped.
 * Without JS every row stays fg-primary.
 */
import Media from "@/components/Media.astro";
import { SERVICES } from "@/lib/services";
import { SHOWREELS, type Showreel, type ServiceValue } from "@/lib/showreels";
import { cn } from "@/lib/utils";
import { Button } from "@/ui/button";

interface Props {
  /** Showreel per service. Defaults to SHOWREELS; the styleguide passes its own. */
  showreels?: Record<ServiceValue, Showreel>;
  class?: string;
}

const { showreels = SHOWREELS, class: className } = Astro.props;

// Row labels: "Web" is shorter than the service title "Website" (as on the Services page bar).
const LABELS: Record<ServiceValue, string> = {
  brand: "Brand",
  web: "Web",
  "digital-products": "Product",
};
---

<section aria-labelledby="services-overview" class={cn("px-container pb-section", className)}>
  <h2
    id="services-overview"
    class="border-t border-border-subtle py-6 text-eyebrow text-fg-primary uppercase"
  >
    Our services
  </h2>
  <div class="flex flex-col gap-20 pt-20">
    <div class="grid-cols-layout">
      <div class="col-span-full flex flex-col items-start gap-12 md:col-span-8 xl:col-span-6">
        <p class="text-headline-xl text-fg-primary">
          Your customers see one company and we design it that way.
        </p>
        <Button as="a" href="/services" variant="secondary">
          Explore more
        </Button>
      </div>
    </div>
    <ul
      data-slot="services-overview"
      class="group/list animate-enter-stagger divide-y divide-border-subtle"
    >
      {SERVICES.map((service) => (
        <li class="group relative grid-cols-layout not-group-hover/list:data-dimmed:text-fg-secondary items-center gap-y-2 rounded-sm py-4 text-fg-primary transition-colors duration-300 ease-in-out group-hover/list:[&:not(:hover)]:text-fg-secondary has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-interactive-focus-ring has-[a:focus-visible]:ring-offset-2 has-[a:focus-visible]:ring-offset-bg-primary">
          <div class="hidden self-start pr-6 md:col-span-3 md:block xl:col-span-2">
            <Media
              video={showreels[service.value]}
              aspect="thumbnail"
              sizes="(min-width: 64rem) 192px, 25vw"
              class="max-w-48"
            />
          </div>
          <a
            href={`/services#${service.anchor}`}
            class="col-span-4 text-headline-lg outline-none after:absolute after:inset-0 md:col-span-2"
          >
            {LABELS[service.value]}
          </a>
          <div class="col-span-8 flex items-center gap-4 md:contents">
            <span class="flex-1 text-body-sm md:col-span-5 md:text-body-md xl:col-span-6 xl:col-start-6">
              {service.description}
            </span>
            <span class="flex md:col-start-12 md:justify-self-end">
              <span class="flex size-6 items-center justify-center rounded-xs bg-interactive-secondary transition-[background-color] duration-300 ease-in-out group-hover:bg-interactive-secondary-hover group-has-[a:focus-visible]:bg-interactive-secondary-hover not-group-hover/list:group-data-active:bg-interactive-secondary-hover">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.25"
                  class="size-6"
                  aria-hidden="true"
                >
                  <path d="M10 8l4 4-4 4" />
                </svg>
              </span>
            </span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Touch devices only (cursor devices use CSS hover): highlight the row under the middle of the
  // viewport, or the tapped row, and dim the rest.
  // Scroll distance (CSS px) after a tap before the scroll highlight takes over again, so the last
  // scroll event of a stopped fling doesn't undo the tap.
  const TAP_RELEASE_DISTANCE = 8;

  const lists = matchMedia("(hover: none)").matches
    ? document.querySelectorAll<HTMLElement>('[data-slot="services-overview"]')
    : [];

  for (const list of lists) {
    const rows = [...list.children] as HTMLElement[];
    let frame = 0;
    // Row held by a tap, and the scroll position when it was tapped.
    let tapped: HTMLElement | null = null;
    let tappedAt = 0;

    // null: no row is highlighted and every row is fg-primary.
    const highlight = (active: HTMLElement | null) => {
      for (const row of rows) {
        row.toggleAttribute("data-active", row === active);
        row.toggleAttribute("data-dimmed", active !== null && row !== active);
      }
    };

    const update = () => {
      frame = 0;
      if (tapped) {
        if (Math.abs(scrollY - tappedAt) < TAP_RELEASE_DISTANCE) return;
        tapped = null;
      }
      const middle = innerHeight / 2;
      const active = rows.find((row) => {
        const { top, bottom } = row.getBoundingClientRect();
        return top <= middle && bottom > middle;
      });
      highlight(active ?? null);
    };
    const schedule = () => {
      frame ||= requestAnimationFrame(update);
    };

    list.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse") return;
      const row = rows.find((r) => r.contains(event.target as Node));
      if (!row) return;
      tapped = row;
      tappedAt = scrollY;
      highlight(row);
    });
    // The touch became a scroll: drop the tap and follow the scroll position.
    list.addEventListener("pointercancel", () => {
      tapped = null;
      schedule();
    });
    // Back from the service page (bfcache): start from the scroll position again.
    addEventListener("pageshow", (event) => {
      if (!event.persisted) return;
      tapped = null;
      schedule();
    });

    // Track scrolling only while the list is on screen.
    new IntersectionObserver(([entry]) => {
      if (entry?.isIntersecting) {
        addEventListener("scroll", schedule, { passive: true });
        addEventListener("resize", schedule);
        schedule();
      } else {
        removeEventListener("scroll", schedule);
        removeEventListener("resize", schedule);
      }
    }).observe(list);
  }
</script>
