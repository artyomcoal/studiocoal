---
/**
 * Journal Archive Section
 * One page of Journal articles as BlogListCards (4 / 2 / 1 columns) and a "View more" link
 * to the next page.
 * Figma: https://www.figma.com/design/xqG6nM7oVW4iev0PrbuqWt/?node-id=5059-8300
 */
import BlogListCard from "@/components/BlogListCard.astro";
import { cn } from "@/lib/utils";
import type { ALL_JOURNAL_QUERY_RESULT } from "@/sanity/types";
import { Button } from "@/ui/button";

interface Props {
  posts: ALL_JOURNAL_QUERY_RESULT;
  /** URL of the next page, if any. */
  nextUrl?: string | undefined;
  class?: string;
}

const { posts, nextUrl, class: className } = Astro.props;
---

<section aria-label="Articles" class={cn("px-container pb-section", className)}>
  {posts.length > 0 ? (
    <div class="flex flex-col">
      <ul class="grid animate-enter-stagger gap-x-2 gap-y-12 md:grid-cols-2 xl:grid-cols-4">
        {posts.map((post) => (
          <li>
            <BlogListCard post={post} as="h2" />
          </li>
        ))}
      </ul>
      {nextUrl && (
        <div class="flex justify-center pt-12 md:pt-16 xl:pt-20">
          <Button as="a" href={nextUrl} variant="secondary">
            View more
          </Button>
        </div>
      )}
    </div>
  ) : (
    <p class="text-body-md text-fg-secondary">The first notes are on their way.</p>
  )}
</section>
